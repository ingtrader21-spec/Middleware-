#!/usr/bin/dash
set -eu

image=ghcr.io/codestra-srl/qwen-auth-verifier@sha256:cc7e2457fdd69fdd1bf766831f8f86396495b47e377e86b2d9df1d4fb5432390
volume=codestra-qwen-auth-verifier_qwen_auth_replay

/usr/bin/docker volume create "$volume" >/dev/null
/usr/bin/docker run --rm --network none --user 0:0 --read-only \
    --cap-drop ALL --cap-add CHOWN --cap-add FOWNER \
    --entrypoint python --volume "$volume:/replay" "$image" -c \
    "import os; p='/replay'; os.chown(p,10001,10001); os.chmod(p,0o700); s=os.stat(p); assert (s.st_uid,s.st_gid,s.st_mode & 0o777)==(10001,10001,0o700)"
echo REPLAY_VOLUME_INITIALIZATION=PASS

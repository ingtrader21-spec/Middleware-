#!/usr/bin/dash
set -eu
umask 077

runtime_dir=/run/codestra/qwen-auth-verifier-secrets
source_hmac=/etc/codestra/secrets/middleware-staging/qwen-ai-01/qwen-ai-01-hmac-20260804-01
source_ca=/etc/codestra/pki/middleware-private-ingress/client-ca.crt

require_source() {
    source_path=$1
    [ -f "$source_path" ] && [ ! -L "$source_path" ]
    [ "$(/usr/bin/stat -c '%U:%G:%a' "$source_path")" = root:root:600 ]
}

clear_exact_runtime_files() {
    [ ! -d "$runtime_dir" ] || [ ! -L "$runtime_dir" ]
    for projected_name in qwen-hmac client-ca.crt; do
        projected_path="$runtime_dir/$projected_name"
        if [ -e "$projected_path" ] || [ -L "$projected_path" ]; then
            [ ! -d "$projected_path" ]
            /usr/bin/unlink "$projected_path"
        fi
    done
    if [ -d "$runtime_dir" ]; then
        [ -z "$(/usr/bin/find "$runtime_dir" -mindepth 1 -maxdepth 1 -print -quit)" ]
    fi
}

[ "$(/usr/bin/findmnt -n -o FSTYPE /run)" = tmpfs ]
require_source "$source_hmac"
require_source "$source_ca"
clear_exact_runtime_files
/usr/bin/install -d -o 10001 -g 10001 -m 0700 "$runtime_dir"
/usr/bin/install -o 10001 -g 10001 -m 0600 "$source_hmac" "$runtime_dir/qwen-hmac"
/usr/bin/install -o 10001 -g 10001 -m 0600 "$source_ca" "$runtime_dir/client-ca.crt"
/usr/bin/cmp -s "$source_hmac" "$runtime_dir/qwen-hmac"
/usr/bin/cmp -s "$source_ca" "$runtime_dir/client-ca.crt"
[ "$(/usr/bin/stat -c '%u:%g:%a' "$runtime_dir/qwen-hmac")" = 10001:10001:600 ]
[ "$(/usr/bin/stat -c '%u:%g:%a' "$runtime_dir/client-ca.crt")" = 10001:10001:600 ]
echo RUNTIME_SECRET_PROJECTION=READY

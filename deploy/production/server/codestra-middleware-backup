#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

CONFIG_FILE="${CODESTRA_MIDDLEWARE_DEPLOY_CONFIG:-/etc/codestra-middleware/deploy.conf}"
REFERENCE=""
STAGE="arguments"
RESTORE_DATABASE=""
TEMPORARY_PATH=""

fail() {
  local reason="${1:-unspecified}"
  printf 'BACKUP_STATUS=FAIL\n' >&2
  printf 'BACKUP_FAILURE_STAGE=%s\n' "$STAGE" >&2
  printf 'BACKUP_FAILURE_REASON=%s\n' "$reason" >&2
  exit 1
}

cleanup() {
  local exit_code=$?
  if [[ -n "$RESTORE_DATABASE" ]]; then
    docker exec -u postgres "$POSTGRES_CONTAINER" \
      dropdb --if-exists --force "$RESTORE_DATABASE" >/dev/null 2>&1 || true
  fi
  if [[ -n "$TEMPORARY_PATH" ]]; then
    rm -f -- "$TEMPORARY_PATH"
  fi
  exit "$exit_code"
}
trap cleanup EXIT

config_value() {
  local key="$1"
  awk -F= -v wanted="$key" '
    /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
    $1 == wanted {
      sub(/^[^=]*=/, "")
      print
      found = 1
    }
    END { if (!found) exit 1 }
  ' "$CONFIG_FILE"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --reference)
      [[ $# -ge 2 ]] || fail "missing_reference_value"
      REFERENCE="$2"
      shift 2
      ;;
    *) fail "unexpected_argument" ;;
  esac
done

[[ "$(id -u)" -eq 0 ]] || fail "root_required"
[[ "$REFERENCE" =~ ^[0-9a-f]{12}-[0-9a-f]{12}$ ]] || fail "invalid_reference"

STAGE="config"
[[ -f "$CONFIG_FILE" && ! -L "$CONFIG_FILE" ]] || fail "config_missing_or_symlink"
[[ "$(stat -c '%u' "$CONFIG_FILE")" -eq 0 ]] || fail "config_not_root_owned"
if find "$CONFIG_FILE" -perm /077 -print -quit | grep -q .; then
  fail "config_permissions_too_broad"
fi

POSTGRES_CONTAINER="$(config_value POSTGRES_CONTAINER)" || fail "postgres_container_missing"
POSTGRES_DATABASE="$(config_value POSTGRES_DATABASE)" || fail "postgres_database_missing"
BACKUP_DIR="$(config_value BACKUP_DIR)" || fail "backup_dir_missing"
OFFHOST_BACKUP_DIR="$(config_value OFFHOST_BACKUP_DIR 2>/dev/null || true)"

[[ "$POSTGRES_CONTAINER" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$ ]] || fail "invalid_postgres_container"
[[ "$POSTGRES_DATABASE" =~ ^[A-Za-z_][A-Za-z0-9_]{0,62}$ ]] || fail "invalid_postgres_database"
[[ "$BACKUP_DIR" == /var/backups/codestra-middleware* ]] || fail "invalid_backup_dir"
[[ "$BACKUP_DIR" != *".."* && "$BACKUP_DIR" != *$'\n'* ]] || fail "unsafe_backup_dir"
if [[ -n "$OFFHOST_BACKUP_DIR" ]]; then
  [[ "$OFFHOST_BACKUP_DIR" == /* && "$OFFHOST_BACKUP_DIR" != *".."* ]] || fail "unsafe_offhost_dir"
fi

STAGE="database_preflight"
container_status="$(docker inspect "$POSTGRES_CONTAINER" --format '{{.State.Status}}' 2>/dev/null || true)"
[[ "$container_status" == "running" ]] || fail "postgres_not_running"
docker exec -u postgres "$POSTGRES_CONTAINER" \
  psql -X -v ON_ERROR_STOP=1 --dbname="$POSTGRES_DATABASE" --tuples-only --no-align \
  --command='SELECT 1' | grep -qx '1' || fail "database_query_failed"

STAGE="backup"
install -d -m 0700 -o root -g root "$BACKUP_DIR"
timestamp="$(date -u +'%Y%m%dT%H%M%SZ')"
final_path="$BACKUP_DIR/middleware-${REFERENCE}-${timestamp}.dump"
TEMPORARY_PATH="$(mktemp "$BACKUP_DIR/.middleware-${REFERENCE}-${timestamp}.XXXXXX.dump")"

docker exec -u postgres "$POSTGRES_CONTAINER" \
  pg_dump \
    --format=custom \
    --compress=9 \
    --no-owner \
    --no-acl \
    --dbname="$POSTGRES_DATABASE" \
  >"$TEMPORARY_PATH"

[[ -s "$TEMPORARY_PATH" ]] || fail "empty_backup"
docker exec -i -u postgres "$POSTGRES_CONTAINER" \
  pg_restore --list - <"$TEMPORARY_PATH" >/dev/null || fail "backup_catalog_invalid"
chmod 0600 "$TEMPORARY_PATH"
mv -f -- "$TEMPORARY_PATH" "$final_path"
TEMPORARY_PATH=""

digest="sha256:$(sha256sum "$final_path" | awk '{print $1}')"
[[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || fail "invalid_backup_digest"

STAGE="restore_rehearsal"
RESTORE_DATABASE="mw_restore_${timestamp//[^0-9]/}_$$"
RESTORE_DATABASE="${RESTORE_DATABASE:0:63}"
docker exec -u postgres "$POSTGRES_CONTAINER" \
  createdb --template=template0 "$RESTORE_DATABASE" || fail "restore_database_create_failed"
docker exec -i -u postgres "$POSTGRES_CONTAINER" \
  pg_restore \
    --exit-on-error \
    --no-owner \
    --no-acl \
    --dbname="$RESTORE_DATABASE" \
    - <"$final_path" || fail "restore_failed"
docker exec -u postgres "$POSTGRES_CONTAINER" \
  psql -X -v ON_ERROR_STOP=1 --dbname="$RESTORE_DATABASE" --tuples-only --no-align \
  --command="SELECT CASE WHEN to_regclass('public.middleware_schema_migrations') IS NULL THEN 'MISSING' ELSE 'PRESENT' END" \
  | grep -qx 'PRESENT' || fail "restored_schema_missing"
restored_table_count="$(
  docker exec -u postgres "$POSTGRES_CONTAINER" \
    psql -X -v ON_ERROR_STOP=1 --dbname="$RESTORE_DATABASE" --tuples-only --no-align \
    --command="SELECT count(*) FROM pg_tables WHERE schemaname='public'"
)"
[[ "$restored_table_count" =~ ^[0-9]+$ && "$restored_table_count" -gt 0 ]] || fail "restored_table_count_invalid"
docker exec -u postgres "$POSTGRES_CONTAINER" \
  dropdb --if-exists --force "$RESTORE_DATABASE" >/dev/null
RESTORE_DATABASE=""

OFFHOST_STATUS="NOT_CONFIGURED"
OFFHOST_REFERENCE="NONE"
if [[ -n "$OFFHOST_BACKUP_DIR" ]]; then
  STAGE="offhost_copy"
  [[ -d "$OFFHOST_BACKUP_DIR" && ! -L "$OFFHOST_BACKUP_DIR" ]] || fail "offhost_dir_missing"
  mountpoint -q "$OFFHOST_BACKUP_DIR" || fail "offhost_dir_not_mountpoint"
  offhost_path="$OFFHOST_BACKUP_DIR/$(basename "$final_path")"
  install -m 0600 -o root -g root "$final_path" "$offhost_path"
  [[ "sha256:$(sha256sum "$offhost_path" | awk '{print $1}')" == "$digest" ]] || fail "offhost_digest_mismatch"
  OFFHOST_STATUS="PASS"
  OFFHOST_REFERENCE="$offhost_path"
fi

STAGE="complete"
trap - EXIT
printf 'BACKUP_STATUS=PASS\n'
printf 'BACKUP_REFERENCE=%s\n' "$final_path"
printf 'BACKUP_SHA256=%s\n' "$digest"
printf 'RESTORE_STATUS=PASS\n'
printf 'RESTORE_DATABASE_DROPPED=YES\n'
printf 'RESTORED_TABLE_COUNT=%s\n' "$restored_table_count"
printf 'OFFHOST_BACKUP_STATUS=%s\n' "$OFFHOST_STATUS"
printf 'OFFHOST_BACKUP_REFERENCE=%s\n' "$OFFHOST_REFERENCE"

)" || fail "platform_schema_readback_failed"
[[ "$platform_table_count" == "4" ]] || fail "platform_schema_incomplete"


snapshot_counts() {
  local output="$1"
  : >"$output"
  mapfile -t tables < <(
    docker exec -u postgres "$POSTGRES_CONTAINER" \
      psql -X -v ON_ERROR_STOP=1 --dbname="$POSTGRES_DATABASE" --tuples-only --no-align \
      --command="SELECT tablename FROM pg_tables WHERE schemaname='public' AND (tablename LIKE 'middleware_%' OR tablename LIKE 'observability_%' OR tablename LIKE 'platform_%') ORDER BY tablename"
  )
  local table count
  for table in "${tables[@]}"; do
    [[ "$table" =~ ^[a-z0-9_]+$ ]] || fail "unsafe_database_table_name"
    count="$(
      docker exec -u postgres "$POSTGRES_CONTAINER" \
        psql -X -v ON_ERROR_STOP=1 --dbname="$POSTGRES_DATABASE" --tuples-only --no-align \
        --command="SELECT count(*) FROM public.\"$table\""
    )"
    [[ "$count" =~ ^[0-9]+$ ]] || fail "invalid_database_row_count"
    printf '%s\t%s\n' "$table" "$count" >>"$output"
  done
  sort -o "$output" "$output"
}


#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

CONTRACT_VERSION="1.0"
SERVER_ROLE="CODESTRA_APPLICATION_SERVER_A"
COMPOSE_PROJECT="codestra-middleware-production-canary"
COMPOSE_SERVICE="middleware-api-canary"
EXPECTED_SCHEMA_HEAD="0067_service_catalog_monitoring_state"
CONFIG_FILE="${CODESTRA_MIDDLEWARE_DEPLOY_CONFIG:-/etc/codestra-middleware/deploy.conf}"
STAGE="arguments"
LOCK_FD=9
WORK_DIR=""
DOCKER_AUTH_DIR=""
COMPOSE_ENV_FILE=""
COMPOSE_FILE=""
CANARY_STARTED_BY_THIS_RUN="false"
PREEXISTING_CANARY="false"
POSTGRES_CONTAINER=""

fail() {
  local reason="${1:-unspecified}"
  printf 'DEPLOYMENT_CONTRACT_VERSION=%s\n' "$CONTRACT_VERSION" >&2
  printf 'DEPLOYMENT_STATUS=FAIL\n' >&2
  printf 'FAILURE_STAGE=%s\n' "$STAGE" >&2
  printf 'FAILURE_REASON=%s\n' "$reason" >&2
  exit 1
}

cleanup() {
  local exit_code=$?
  if [[ "$exit_code" -ne 0 && "$CANARY_STARTED_BY_THIS_RUN" == "true" && "$PREEXISTING_CANARY" == "false" && -n "$COMPOSE_ENV_FILE" ]]; then
    docker compose \
      --project-name "$COMPOSE_PROJECT" \
      --env-file "$COMPOSE_ENV_FILE" \
      -f "$COMPOSE_FILE" \
      rm -sf "$COMPOSE_SERVICE" >/dev/null 2>&1 || true
  fi
  [[ -z "$WORK_DIR" ]] || rm -rf -- "$WORK_DIR"
  [[ -z "$DOCKER_AUTH_DIR" ]] || rm -rf -- "$DOCKER_AUTH_DIR"
  exit "$exit_code"
}
trap cleanup EXIT

config_value() {
  local key="$1"
  awk -F= -v wanted="$key" '
    /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
    $1 == wanted {
      sub(/^[^=]*=/, "")
      print
      found = 1
    }
    END { if (!found) exit 1 }
  ' "$CONFIG_FILE"
}

kv_value() {
  local text="$1"
  local key="$2"
  printf '%s\n' "$text" | awk -F= -v wanted="$key" '$1 == wanted {sub(/^[^=]*=/, ""); print; found=1} END {if (!found) exit 1}'
}

SOURCE_SHA=""
IMAGE_REFERENCE=""
RELEASE_RUN_ID=""
RELEASE_ID=""
BUNDLE_PATH=""
BUNDLE_SHA256=""
CONTROLLER_SHA256=""
MODE=""
READ_REGISTRY_TOKEN="false"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --source-sha) [[ $# -ge 2 ]] || fail "missing_source_sha"; SOURCE_SHA="$2"; shift 2 ;;
    --image-reference) [[ $# -ge 2 ]] || fail "missing_image_reference"; IMAGE_REFERENCE="$2"; shift 2 ;;
    --release-run-id) [[ $# -ge 2 ]] || fail "missing_release_run_id"; RELEASE_RUN_ID="$2"; shift 2 ;;
    --release-id) [[ $# -ge 2 ]] || fail "missing_release_id"; RELEASE_ID="$2"; shift 2 ;;
    --bundle-path) [[ $# -ge 2 ]] || fail "missing_bundle_path"; BUNDLE_PATH="$2"; shift 2 ;;
    --bundle-sha256) [[ $# -ge 2 ]] || fail "missing_bundle_sha256"; BUNDLE_SHA256="$2"; shift 2 ;;
    --controller-sha256) [[ $# -ge 2 ]] || fail "missing_controller_sha256"; CONTROLLER_SHA256="$2"; shift 2 ;;
    --mode) [[ $# -ge 2 ]] || fail "missing_mode"; MODE="$2"; shift 2 ;;
    --registry-token-stdin) READ_REGISTRY_TOKEN="true"; shift ;;
    *) fail "unexpected_argument" ;;
  esac
done

[[ "$(id -u)" -eq 0 ]] || fail "root_required"
[[ "$SOURCE_SHA" =~ ^[0-9a-f]{40}$ ]] || fail "invalid_source_sha"
[[ "$IMAGE_REFERENCE" =~ ^ghcr\.io/ingtrader21-spec/codestra-middleware@sha256:[0-9a-f]{64}$ ]] || fail "invalid_image_reference"
[[ "$RELEASE_RUN_ID" =~ ^[1-9][0-9]{5,19}$ ]] || fail "invalid_release_run_id"
[[ "$RELEASE_ID" =~ ^[0-9a-f]{12}-[0-9a-f]{12}$ ]] || fail "invalid_release_id"
[[ "$BUNDLE_SHA256" =~ ^sha256:[0-9a-f]{64}$ ]] || fail "invalid_bundle_sha256"
[[ "$CONTROLLER_SHA256" =~ ^sha256:[0-9a-f]{64}$ ]] || fail "invalid_controller_sha256"
[[ "$MODE" == "READ_ONLY_CANARY" ]] || fail "unsupported_mode"
[[ "$READ_REGISTRY_TOKEN" == "true" ]] || fail "registry_token_stdin_required"
IMAGE_DIGEST="${IMAGE_REFERENCE##*@}"

STAGE="controller_identity"
actual_controller_sha256="sha256:$(sha256sum "$0" | awk '{print $1}')"
[[ "$actual_controller_sha256" == "$CONTROLLER_SHA256" ]] || fail "installed_controller_checksum_mismatch"

STAGE="config"
[[ -f "$CONFIG_FILE" && ! -L "$CONFIG_FILE" ]] || fail "config_missing_or_symlink"
[[ "$(stat -c '%u' "$CONFIG_FILE")" -eq 0 ]] || fail "config_not_root_owned"
if find "$CONFIG_FILE" -perm /077 -print -quit | grep -q .; then
  fail "config_permissions_too_broad"
fi

DEPLOY_USER="$(config_value DEPLOY_USER)" || fail "deploy_user_missing"
INCOMING_DIR="$(config_value INCOMING_DIR)" || fail "incoming_dir_missing"
RELEASES_DIR="$(config_value RELEASES_DIR)" || fail "releases_dir_missing"
RUNTIME_ENV_FILE="$(config_value RUNTIME_ENV_FILE)" || fail "runtime_env_file_missing"
RUNTIME_NETWORK="$(config_value RUNTIME_NETWORK)" || fail "runtime_network_missing"
POSTGRES_CONTAINER="$(config_value POSTGRES_CONTAINER)" || fail "postgres_container_missing"
REDIS_CONTAINER="$(config_value REDIS_CONTAINER)" || fail "redis_container_missing"
POSTGRES_DATABASE="$(config_value POSTGRES_DATABASE)" || fail "postgres_database_missing"
BACKUP_COMMAND="$(config_value BACKUP_COMMAND)" || fail "backup_command_missing"
EVIDENCE_DIR="$(config_value EVIDENCE_DIR)" || fail "evidence_dir_missing"
GHCR_USERNAME="$(config_value GHCR_USERNAME)" || fail "ghcr_username_missing"
FORWARDED_ALLOW_IPS="$(config_value FORWARDED_ALLOW_IPS)" || fail "forwarded_allow_ips_missing"
OBSERVATION_SECONDS="$(config_value OBSERVATION_SECONDS)" || fail "observation_seconds_missing"

[[ "$DEPLOY_USER" == "middleware-deploy" ]] || fail "unexpected_deploy_user"
[[ "${SUDO_USER:-}" == "$DEPLOY_USER" ]] || fail "restricted_sudo_caller_required"
[[ "$INCOMING_DIR" == /home/middleware-deploy/incoming && "$INCOMING_DIR" != *".."* ]] || fail "unsafe_incoming_dir"
[[ "$RELEASES_DIR" == /srv/codestra-middleware/releases && "$RELEASES_DIR" != *".."* ]] || fail "unsafe_releases_dir"
[[ "$RUNTIME_ENV_FILE" == /etc/codestra-middleware/runtime.env ]] || fail "unsafe_runtime_env_path"
[[ "$POSTGRES_CONTAINER" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$ ]] || fail "invalid_postgres_container"
[[ "$REDIS_CONTAINER" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$ ]] || fail "invalid_redis_container"
[[ "$POSTGRES_DATABASE" =~ ^[A-Za-z_][A-Za-z0-9_]{0,62}$ ]] || fail "invalid_postgres_database"
[[ "$BACKUP_COMMAND" == /usr/local/sbin/codestra-middleware-backup ]] || fail "unexpected_backup_command"
[[ -x "$BACKUP_COMMAND" && ! -L "$BACKUP_COMMAND" ]] || fail "backup_command_missing_or_symlink"
[[ "$EVIDENCE_DIR" == /var/lib/codestra-middleware/deployments && "$EVIDENCE_DIR" != *".."* ]] || fail "unsafe_evidence_dir"
[[ "$GHCR_USERNAME" == "appolon1908-hue" ]] || fail "unexpected_registry_username"
[[ "$FORWARDED_ALLOW_IPS" =~ ^[A-Za-z0-9:.,/-]+$ ]] || fail "invalid_forwarded_allow_ips"
[[ "$OBSERVATION_SECONDS" =~ ^[0-9]+$ && "$OBSERVATION_SECONDS" -ge 30 && "$OBSERVATION_SECONDS" -le 300 ]] || fail "invalid_observation_seconds"

install -d -m 0700 -o "$DEPLOY_USER" -g "$DEPLOY_USER" "$INCOMING_DIR"
install -d -m 0700 -o root -g root "$RELEASES_DIR" "$EVIDENCE_DIR"
[[ -f "$RUNTIME_ENV_FILE" && ! -L "$RUNTIME_ENV_FILE" ]] || fail "runtime_env_missing_or_symlink"
[[ "$(stat -c '%u' "$RUNTIME_ENV_FILE")" -eq 0 ]] || fail "runtime_env_not_root_owned"
if find "$RUNTIME_ENV_FILE" -perm /077 -print -quit | grep -q .; then
  fail "runtime_env_permissions_too_broad"
fi

STAGE="runtime_environment"
python3 - "$RUNTIME_ENV_FILE" <<'PY'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
values: dict[str, str] = {}
for number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    if line.startswith("export "):
        line = line[7:].strip()
    if "=" not in line:
        raise SystemExit(f"invalid runtime env line {number}")
    key, value = line.split("=", 1)
    key = key.strip()
    value = value.strip()
    if not re.fullmatch(r"[A-Z][A-Z0-9_]*", key) or key in values:
        raise SystemExit(f"invalid or duplicate runtime env key at line {number}")
    if len(value) >= 2 and value[0] == value[-1] and value[0] in {'"', "'"}:
        value = value[1:-1]
    values[key] = value

exact = {
    "APP_ENV": "production",
    "RUNTIME_PROFILE_ID": "codestra-middleware-production-compose-v1",
    "ALLOW_IN_MEMORY_STORAGE": "false",
    "NATS_DISPATCH_MODE": "disabled",
    "TEMPORAL_WORKER_MODE": "disabled",
    "OUTBOX_DISPATCH_ENABLED": "false",
    "SEND_EVENTS": "false",
    "ENABLE_EXTERNAL_DELIVERY": "false",
    "LIVE_WRITE": "false",
    "LIVE_WRITES": "false",
    "ODOO_WRITE": "false",
    "KLYROW_EVENT_INGRESS_ENABLED": "false",
    "KLYROW_ODOO_PROJECTION_ENABLED": "false",
    "FORM_ODOO_DELIVERY_ENABLED": "false",
    "CRAWLER_ODOO_DELIVERY_ENABLED": "false",
    "SCRAPPER_ODOO_DELIVERY_ENABLED": "false",
    "CALLBACK_DISPATCH": "false",
    "N8N_DELIVERY_ENABLED": "false",
    "VICIDIAL_WRITES_ENABLED": "false",
    "EXTERNAL_DIAL_ENABLED": "false",
    "PRODUCTION_CALLBACKS_ENABLED": "false",
    "N8N_PRODUCTION_WORKFLOWS_ENABLED": "false",
    "PRODUCTION_DIALING": "DISABLED",
    "SMS_DELIVERY_ENABLED": "false",
    "EMAIL_DELIVERY_ENABLED": "false",
    "SOCIAL_DELIVERY_ENABLED": "false",
    "CRAWLER_EXECUTION_ENABLED": "false",
    "SCRAPPER_EXECUTION_ENABLED": "false",
    "CRAWLER_EXTERNAL_CONTACT_ENABLED": "false",
    "SCRAPPER_EXTERNAL_CONTACT_ENABLED": "false",
    "LIVE_SMS_DELIVERY": "false",
    "LIVE_EMAIL_DELIVERY": "false",
    "UNRESTRICTED_CRAWLING": "false",
    "LIVE_ADVERTISING_ENABLED": "false",
    "EXTERNAL_DELIVERY_ENABLED": "false",
    "SOCIAL_PUBLISHING_ENABLED": "false",
    "EXTERNAL_MODEL_CALLS_ENABLED": "false",
    "N8N_EXTERNAL_PROVIDER_WRITES": "false",
}
for key, expected in exact.items():
    if values.get(key, "").lower() != expected.lower():
        raise SystemExit(f"unsafe runtime setting: {key}")
for key in ("DATABASE_URL", "REDIS_URL"):
    value = values.get(key, "")
    if not value or "<inject-secret>" in value or "REPLACE_" in value:
        raise SystemExit(f"runtime dependency setting missing: {key}")
for producer in (
    "ODOO_INTEGRATION", "N8N_AUTOMATION", "VICIDIAL_ADAPTER",
    "TELNEXA_GATEWAY", "KLYROW_GATEWAY", "KYQRA_GATEWAY", "POSTLY_ADAPTER",
):
    key = f"WEBHOOK_SECRET_{producer}"
    if len(values.get(key, "")) < 32:
        raise SystemExit(f"runtime webhook secret missing: {key}")
print("RUNTIME_ENVIRONMENT=PASS")
PY

STAGE="bundle_preflight"
[[ -f "$BUNDLE_PATH" && ! -L "$BUNDLE_PATH" ]] || fail "bundle_missing_or_symlink"
incoming_real="$(realpath -e -- "$INCOMING_DIR")" || fail "incoming_dir_unresolved"
bundle_real="$(realpath -e -- "$BUNDLE_PATH")" || fail "bundle_unresolved"
case "$bundle_real" in "$incoming_real"/*) ;; *) fail "bundle_outside_incoming_dir" ;; esac
[[ "$(stat -c '%U' "$bundle_real")" == "$DEPLOY_USER" ]] || fail "bundle_owner_invalid"
if find "$bundle_real" -perm /022 -print -quit | grep -q .; then
  fail "bundle_permissions_too_broad"
fi
actual_bundle_sha256="sha256:$(sha256sum "$bundle_real" | awk '{print $1}')"
[[ "$actual_bundle_sha256" == "$BUNDLE_SHA256" ]] || fail "bundle_checksum_mismatch"

exec {LOCK_FD}>/run/lock/codestra-middleware-production.lock
flock -n "$LOCK_FD" || fail "deployment_lock_busy"

WORK_DIR="$(mktemp -d "$RELEASES_DIR/.incoming-${RELEASE_ID}.XXXXXX")"
python3 - "$bundle_real" "$WORK_DIR" <<'PY'
from pathlib import Path, PurePosixPath
import shutil
import sys
import tarfile

archive = Path(sys.argv[1])
destination = Path(sys.argv[2]).resolve()
with tarfile.open(archive, "r:gz") as bundle:
    members = bundle.getmembers()
    if not members or len(members) > 10000:
        raise SystemExit("unsafe bundle member count")
    for member in members:
        relative = PurePosixPath(member.name)
        if relative.is_absolute() or ".." in relative.parts:
            raise SystemExit("unsafe bundle path")
        if not (member.isdir() or member.isfile()):
            raise SystemExit("bundle links and special files are forbidden")
        target = (destination / Path(*relative.parts)).resolve()
        if destination != target and destination not in target.parents:
            raise SystemExit("bundle path escapes destination")
    bundle.extractall(destination)
PY

MANIFEST_FILE="$WORK_DIR/release/release-manifest.v1.json"
MANIFEST_BUNDLE_FILE="$WORK_DIR/release/release-manifest.v1.sigstore.json"
COMPOSE_FILE="$WORK_DIR/deployment/compose.canary.yaml"
CONTRACT_FILE="$WORK_DIR/deployment/server-command-contract.v1.json"
for required_file in "$MANIFEST_FILE" "$MANIFEST_BUNDLE_FILE" "$COMPOSE_FILE" "$CONTRACT_FILE"; do
  [[ -f "$required_file" && ! -L "$required_file" ]] || fail "required_bundle_file_missing"
done

STAGE="release_manifest"
BUILD_TIME="$(python3 - "$WORK_DIR/release" "$SOURCE_SHA" "$IMAGE_REFERENCE" "$RELEASE_RUN_ID" "$RELEASE_ID" <<'PY'
from pathlib import Path
import hashlib
import json
import re
import sys

release_dir = Path(sys.argv[1])
source_sha, image_reference, run_id, release_id = sys.argv[2:]
manifest_path = release_dir / "release-manifest.v1.json"
value = json.loads(manifest_path.read_text(encoding="utf-8"))
required = {
    "schema_version": "1.0",
    "repository": "appolon1908-hue/Middleware-",
    "service": "middleware-api",
    "release_id": release_id,
}
for key, expected in required.items():
    if value.get(key) != expected:
        raise SystemExit(f"release manifest mismatch: {key}")
source = value.get("source", {})
if source != {
    "git_sha": source_sha,
    "git_tree_id": source.get("git_tree_id"),
    "ref": "refs/heads/main",
} or not re.fullmatch(r"[0-9a-f]{40}", str(source.get("git_tree_id", ""))):
    raise SystemExit("release source authority mismatch")
image = value.get("image", {})
if image.get("reference") != image_reference or image.get("digest") != image_reference.rsplit("@", 1)[1]:
    raise SystemExit("release image authority mismatch")
build = value.get("build", {})
if str(build.get("run_id")) != run_id or build.get("workflow_path") != ".github/workflows/release.yml":
    raise SystemExit("release workflow authority mismatch")
runtime = value.get("runtime", {})
if runtime.get("schema_or_migration_head") != "0067_service_catalog_monitoring_state" or runtime.get("external_effects_default") != "disabled":
    raise SystemExit("release runtime authority mismatch")
promotion = value.get("promotion", {})
if promotion.get("mutable_tags_authoritative") is not False or promotion.get("staging_and_production_same_digest") is not True:
    raise SystemExit("release promotion authority mismatch")
verification = value.get("verification", {})
identity = "https://github.com/appolon1908-hue/Middleware-/.github/workflows/release.yml@refs/heads/main"
if verification.get("certificate_identity") != identity or verification.get("oidc_issuer") != "https://token.actions.githubusercontent.com":
    raise SystemExit("release signer authority mismatch")
for artifact_name in ("sbom", "vulnerability_report"):
    artifact = value.get("artifacts", {}).get(artifact_name, {})
    path = release_dir / str(artifact.get("path", ""))
    expected_digest = str(artifact.get("sha256", ""))
    if not path.is_file() or not re.fullmatch(r"sha256:[0-9a-f]{64}", expected_digest):
        raise SystemExit(f"release artifact missing: {artifact_name}")
    actual = "sha256:" + hashlib.sha256(path.read_bytes()).hexdigest()
    if actual != expected_digest:
        raise SystemExit(f"release artifact checksum mismatch: {artifact_name}")
built_at = str(build.get("built_at", ""))
if not built_at.endswith("Z"):
    raise SystemExit("release build time invalid")
print(built_at)
PY
)" || fail "release_manifest_invalid"

STAGE="runtime_network"
for dependency_container in "$POSTGRES_CONTAINER" "$REDIS_CONTAINER"; do
  [[ "$(docker inspect "$dependency_container" --format '{{.State.Status}}' 2>/dev/null || true)" == "running" ]] || fail "dependency_container_not_running"
done
if [[ "$RUNTIME_NETWORK" == "AUTO" ]]; then
  postgres_networks="$(mktemp)"
  redis_networks="$(mktemp)"
  docker inspect "$POSTGRES_CONTAINER" --format '{{range $name, $_ := .NetworkSettings.Networks}}{{println $name}}{{end}}' | sort -u >"$postgres_networks"
  docker inspect "$REDIS_CONTAINER" --format '{{range $name, $_ := .NetworkSettings.Networks}}{{println $name}}{{end}}' | sort -u >"$redis_networks"
  mapfile -t common_networks < <(comm -12 "$postgres_networks" "$redis_networks" | grep -Ev '^(bridge|host|none)$' || true)
  rm -f "$postgres_networks" "$redis_networks"
  [[ "${#common_networks[@]}" -eq 1 ]] || fail "runtime_network_auto_detection_not_unique"
  RUNTIME_NETWORK="${common_networks[0]}"
fi
[[ "$RUNTIME_NETWORK" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$ ]] || fail "invalid_runtime_network"
docker network inspect "$RUNTIME_NETWORK" >/dev/null 2>&1 || fail "runtime_network_missing"

STAGE="configuration_identity"
CONFIGURATION_CHECKSUM="$(python3 - "$RUNTIME_ENV_FILE" "$COMPOSE_FILE" "$CONTRACT_FILE" "$MANIFEST_FILE" "$RUNTIME_NETWORK" <<'PYCONF'
from pathlib import Path
import hashlib
import json
import re
import sys

env_path = Path(sys.argv[1])
compose_path = Path(sys.argv[2])
contract_path = Path(sys.argv[3])
manifest_path = Path(sys.argv[4])
network = sys.argv[5]
values: dict[str, str] = {}
for raw in env_path.read_text(encoding="utf-8").splitlines():
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    if line.startswith("export "):
        line = line[7:].strip()
    key, value = line.split("=", 1)
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in {'"', "'"}:
        value = value[1:-1]
    sensitive = re.search(
        r"(PASSWORD|TOKEN|SECRET|PRIVATE|CREDENTIAL|DATABASE_URL|REDIS_URL|NATS_URL|CERT|KEY)",
        key,
        re.IGNORECASE,
    )
    values[key] = "<redacted-present>" if sensitive and value else "<redacted-empty>" if sensitive else value
payload = {
    "runtime_environment": dict(sorted(values.items())),
    "runtime_network": network,
    "compose_sha256": hashlib.sha256(compose_path.read_bytes()).hexdigest(),
    "contract_sha256": hashlib.sha256(contract_path.read_bytes()).hexdigest(),
    "release_manifest_sha256": hashlib.sha256(manifest_path.read_bytes()).hexdigest(),
}
print(hashlib.sha256(json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()).hexdigest())
PYCONF
)" || fail "configuration_checksum_failed"
[[ "$CONFIGURATION_CHECKSUM" =~ ^[0-9a-f]{64}$ ]] || fail "configuration_checksum_invalid"

STAGE="deployment_source_integrity"
BUNDLED_BACKUP="$WORK_DIR/deployment/server/codestra-middleware-backup"
[[ -f "$BUNDLED_BACKUP" && ! -L "$BUNDLED_BACKUP" ]] || fail "bundled_backup_missing"
[[ "sha256:$(sha256sum "$BUNDLED_BACKUP" | awk '{print $1}')" == "sha256:$(sha256sum "$BACKUP_COMMAND" | awk '{print $1}')" ]] || fail "installed_backup_checksum_mismatch"

COMPOSE_ENV_FILE="$WORK_DIR/compose.env"
cat >"$COMPOSE_ENV_FILE" <<EOFENV
MIDDLEWARE_IMAGE_REFERENCE=$IMAGE_REFERENCE
MIDDLEWARE_RUNTIME_ENV_FILE=$RUNTIME_ENV_FILE
MIDDLEWARE_SOURCE_SHA=$SOURCE_SHA
MIDDLEWARE_IMAGE_DIGEST=$IMAGE_DIGEST
MIDDLEWARE_RELEASE_ID=$RELEASE_ID
MIDDLEWARE_APP_VERSION=sha-$SOURCE_SHA
MIDDLEWARE_BUILD_TIME=$BUILD_TIME
MIDDLEWARE_CONFIGURATION_CHECKSUM=$CONFIGURATION_CHECKSUM
MIDDLEWARE_RUNTIME_NETWORK=$RUNTIME_NETWORK
MIDDLEWARE_FORWARDED_ALLOW_IPS=$FORWARDED_ALLOW_IPS
EOFENV
chmod 0600 "$COMPOSE_ENV_FILE"

python3 - "$COMPOSE_FILE" <<'PYCOMPOSE'
from pathlib import Path
import re
import sys
text = Path(sys.argv[1]).read_text(encoding="utf-8")
required = (
    "name: codestra-middleware-production-canary",
    "middleware-api-canary:",
    "middleware-migrate-canary:",
    "read_only: true",
    "no-new-privileges:true",
    "pull_policy: never",
    'PRODUCTION_DIALING: DISABLED',
    'OUTBOX_DISPATCH_ENABLED: "false"',
)
for item in required:
    if item not in text:
        raise SystemExit(f"compose requirement missing: {item}")
for pattern in (
    r"(?m)^\s*ports:\s*$",
    r"privileged:\s*true",
    r"/var/run/docker\.sock",
    r"network_mode:\s*host",
    r"pid:\s*host",
    r"image:\s*[^\n]*:latest(?:\s|$)",
):
    if re.search(pattern, text, re.IGNORECASE):
        raise SystemExit(f"unsafe compose pattern: {pattern}")
PYCOMPOSE

declare -a COMPOSE=(
  docker compose
  --project-name "$COMPOSE_PROJECT"
  --env-file "$COMPOSE_ENV_FILE"
  -f "$COMPOSE_FILE"
)
"${COMPOSE[@]}" config --quiet || fail "compose_render_failed"

STAGE="registry_authentication"
IFS= read -r registry_token || fail "registry_token_read_failed"
[[ ${#registry_token} -ge 8 ]] || fail "registry_token_empty"
DOCKER_AUTH_DIR="$(mktemp -d)"
printf '%s' "$registry_token" | docker --config "$DOCKER_AUTH_DIR" login ghcr.io --username "$GHCR_USERNAME" --password-stdin >/dev/null
unset registry_token

STAGE="immutable_image"
docker --config "$DOCKER_AUTH_DIR" pull "$IMAGE_REFERENCE" >/dev/null || fail "immutable_image_pull_failed"
docker --config "$DOCKER_AUTH_DIR" logout ghcr.io >/dev/null 2>&1 || true
rm -rf "$DOCKER_AUTH_DIR"
DOCKER_AUTH_DIR=""
image_revision="$(docker image inspect "$IMAGE_REFERENCE" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' 2>/dev/null || true)"
image_version="$(docker image inspect "$IMAGE_REFERENCE" --format '{{index .Config.Labels "org.opencontainers.image.version"}}' 2>/dev/null || true)"
image_user="$(docker image inspect "$IMAGE_REFERENCE" --format '{{.Config.User}}' 2>/dev/null || true)"

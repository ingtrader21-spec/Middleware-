wait_for_canary() {
  local timeout_seconds=120
  local started now container_id status health
  started="$(date +%s)"
  while true; do
    container_id="$("${COMPOSE[@]}" ps -q "$COMPOSE_SERVICE" 2>/dev/null || true)"
    if [[ -n "$container_id" ]]; then
      status="$(docker inspect "$container_id" --format '{{.State.Status}}' 2>/dev/null || true)"
      health="$(docker inspect "$container_id" --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' 2>/dev/null || true)"
      if [[ "$status" == "running" && "$health" == "healthy" ]]; then
        printf '%s' "$container_id"
        return 0
      fi
    fi
    now="$(date +%s)"
    (( now - started < timeout_seconds )) || return 1
    sleep 3
  done
}

fetch_endpoint() {
  local container_id="$1"
  local endpoint="$2"
  local output="$3"
  docker exec "$container_id" /usr/local/bin/python3.14 -c \
    'import sys,urllib.request; r=urllib.request.urlopen("http://127.0.0.1:8095"+sys.argv[1],timeout=5); assert r.status==200; sys.stdout.write(r.read().decode("utf-8"))' \
    "$endpoint" >"$output"
}

verify_runtime() {
  local container_id="$1"
  local prefix="$2"
  fetch_endpoint "$container_id" /health "$EVIDENCE_RUN_DIR/${prefix}-health.json"
  fetch_endpoint "$container_id" /readiness "$EVIDENCE_RUN_DIR/${prefix}-readiness.json"
  fetch_endpoint "$container_id" /version "$EVIDENCE_RUN_DIR/${prefix}-version.json"
  fetch_endpoint "$container_id" /capabilities "$EVIDENCE_RUN_DIR/${prefix}-capabilities.json"
  python3 - \
    "$EVIDENCE_RUN_DIR/${prefix}-health.json" \
    "$EVIDENCE_RUN_DIR/${prefix}-readiness.json" \
    "$EVIDENCE_RUN_DIR/${prefix}-version.json" \
    "$EVIDENCE_RUN_DIR/${prefix}-capabilities.json" \
    "$SOURCE_SHA" "$IMAGE_DIGEST" "$RELEASE_ID" "$CONFIGURATION_CHECKSUM" <<'PYVERIFY'
from pathlib import Path
import json
import sys
health, readiness, version, capabilities = [json.loads(Path(path).read_text()) for path in sys.argv[1:5]]
source_sha, image_digest, release_id, configuration_checksum = sys.argv[5:]
if health != {"status": "ok", "service": "middleware-api", "component": "api"}:
    raise SystemExit("health projection mismatch")
if readiness.get("status") != "ready" or readiness.get("environment") != "production":
    raise SystemExit("readiness is not production-ready")
if readiness.get("release_sha") != source_sha or readiness.get("image_digest") != image_digest:
    raise SystemExit("readiness source or image mismatch")
if readiness.get("schema_or_migration_head") != "0067_service_catalog_monitoring_state":
    raise SystemExit("readiness migration head mismatch")
expected_version = {
    "environment": "production",
    "runtime_profile_id": "codestra-middleware-production-compose-v1",
    "source_sha": source_sha,
    "git_sha": source_sha,
    "image_digest": image_digest,
    "schema_head": "0067_service_catalog_monitoring_state",
    "schema_version": "0067_service_catalog_monitoring_state",
    "release_id": release_id,
    "configuration_checksum": configuration_checksum,
}
for key, expected in expected_version.items():
    if version.get(key) != expected:
        raise SystemExit(f"version mismatch: {key}")
values = capabilities.get("capabilities")
if capabilities.get("environment") != "production" or not isinstance(values, dict) or not values:
    raise SystemExit("capability projection invalid")
if any(value is not False for value in values.values()):
    raise SystemExit("an external capability is enabled")
PYVERIFY

  docker inspect "$container_id" >"$EVIDENCE_RUN_DIR/${prefix}-container-inspect.json"
  python3 - "$EVIDENCE_RUN_DIR/${prefix}-container-inspect.json" "$IMAGE_REFERENCE" <<'PYINSPECT'
from pathlib import Path
import json
import sys
rows = json.loads(Path(sys.argv[1]).read_text())
if len(rows) != 1:
    raise SystemExit("container inspect cardinality mismatch")
row = rows[0]
expected_image = sys.argv[2]
if row.get("Config", {}).get("Image") != expected_image:
    raise SystemExit("container image reference mismatch")
host = row.get("HostConfig", {})
if host.get("Privileged") is not False or host.get("ReadonlyRootfs") is not True:
    raise SystemExit("container privilege or rootfs policy mismatch")
if set(host.get("CapDrop") or []) != {"ALL"}:
    raise SystemExit("container capability drop mismatch")
if "no-new-privileges:true" not in (host.get("SecurityOpt") or []):
    raise SystemExit("container no-new-privileges missing")
if host.get("PortBindings") not in (None, {}):
    raise SystemExit("canary publishes a port")
labels = row.get("Config", {}).get("Labels") or {}
if labels.get("com.codestra.gateway.exposure") != "none":
    raise SystemExit("gateway exposure label mismatch")
for key in labels:
    lowered = key.lower()
    if lowered.startswith(("traefik.", "caddy.", "kong.")):
        raise SystemExit("proxy discovery label is forbidden")
state = row.get("State", {})
if state.get("Status") != "running" or (state.get("Health") or {}).get("Status") != "healthy":
    raise SystemExit("container is not healthy")
PYINSPECT
}


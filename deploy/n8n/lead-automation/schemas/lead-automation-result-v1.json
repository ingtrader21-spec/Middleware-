{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Lead Automation Result V1","type":"object","additionalProperties":false,"required":["contract_version","event_id","workflow_execution_id","binding_key","environment","business_unit_key","campaign_key","automation_action","result_status","result_code","result_payload","occurred_at","idempotency_key"],"properties":{"contract_version":{"const":"1.0"},"event_id":{"type":"string","maxLength":68},"workflow_execution_id":{"type":"string","pattern":"^N8N-[A-Za-z0-9_-]{8,64}$","maxLength":68},"binding_key":{"const":"n8n.leads.ingest"},"environment":{"enum":["test","staging","production"]},"business_unit_key":{"type":"string","maxLength":63},"campaign_key":{"type":"string","maxLength":64},"automation_action":{"enum":["CREATE_LEAD","UPDATE_ALLOWLISTED_FIELDS","ASSIGN_AUTHORIZED_TEAM","ASSIGN_AUTHORIZED_USER","CHANGE_AUTHORIZED_STAGE","CREATE_INTERNAL_CALLBACK_ACTIVITY"]},"result_status":{"enum":["SUCCEEDED","REJECTED","RETRYABLE_FAILURE","PERMANENT_FAILURE"]},"result_code":{"type":"string","pattern":"^[A-Z0-9_]{1,48}$"},"result_payload":{"type":"object","additionalProperties":false,"maxProperties":6,"properties":{"field_updates":{"type":"object","additionalProperties":{"type":["string","number","boolean","null"]},"maxProperties":12,"propertyNames":{"pattern":"^[a-z][a-z0-9_]{0,47}$"}},"authorized_team_key":{"type":"string","pattern":"^[A-Z0-9_-]{1,32}$"},"authorized_user_key":{"type":"string","pattern":"^[A-Z0-9_-]{1,32}$"},"authorized_stage_key":{"type":"string","pattern":"^[A-Z0-9_-]{1,32}$"},"callback_due_at":{"type":"string","format":"date-time","maxLength":35},"transformation_version":{"type":"string","maxLength":32}}},"occurred_at":{"type":"string","format":"date-time","maxLength":35},"idempotency_key":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"}}}

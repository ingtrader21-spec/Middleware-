# Codestra production WebRTC configuration template. No secrets belong here.
# REQUIRED, default-deny: exact canonical identity and service endpoints.
KEYCLOAK_ISSUER=https://auth.codestra.co/realms/codestra
WEBPHONE_ORIGIN_HOST=phone.codestra.agency
WEBPHONE_WSS_URL=wss://wss.codestra.agency:8089/ws
WEBRTC_PRODUCTION_POLICY_FILE=/etc/codestra/webrtc/production-policy.json
WEBRTC_APPROVED_ARTIFACT_DIGEST_FILE=/etc/codestra/webrtc/approved-artifact-digest

# REQUIRED activation gates. Keep false until the signed human manifest passes.
PRODUCTION_WEBRTC_ENABLED=false
LIVE_PSTN_DIALING=false
PRODUCTION_DIALING_ENABLED=false
WEBRTC_PILOT_KILL_SWITCH=true

# REQUIRED first-pilot ceilings.
PILOT_MAX_CONCURRENT_CALLS=1
PILOT_MAX_CALL_ATTEMPTS=1

# SECRET references (values are root/service protected files, never environment values).
PROVISIONING_CLIENT_SECRET_FILE=/run/secrets/provisioning/client_secret
ODOO_IDENTITY_HMAC_FILE=/run/secrets/odoo/identity_hmac

# OPTIONAL observability endpoints; no credentials.
WEBRTC_METRICS_ENABLED=true
WEBRTC_AUDIT_ENABLED=true
KLYROW_MAIL_INGRESS_ENABLED=false
KLYROW_MAIL_HMAC_SECRET_FILE=/run/secrets/klyrow_mail_event_hmac
KLYROW_MAIL_ODOO_DELIVERY_ENABLED=false
KLYROW_MAIL_ODOO_URL=https://odoo.internal.codestra.agency
KLYROW_MAIL_ODOO_DATABASE=
KLYROW_MAIL_ODOO_USERNAME=
KLYROW_MAIL_ODOO_API_KEY_FILE=/run/secrets/klyrow_mail_odoo_api_key

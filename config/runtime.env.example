APP_ENV=staging
RUNTIME_PROFILE_ID=codestra-middleware-staging-v1
APP_VERSION=0.1.0
APP_SOURCE_SHA=
IMAGE_DIGEST=
SCHEMA_HEAD=0069_progressive_tenant_rls
BUILD_TIME=
RELEASE_ID=
CONFIGURATION_CHECKSUM=

KEYCLOAK_ISSUER=https://auth.codestra.co/realms/codestra
KEYCLOAK_JWKS_URI=https://auth.codestra.co/realms/codestra/protocol/openid-connect/certs
JWKS_TIMEOUT_SECONDS=3
READINESS_TIMEOUT_SECONDS=3
MIDDLEWARE_AUDIENCE=middleware-api

DATABASE_URL=
REDIS_URL=
NATS_URL=
NATS_STREAM=CODESTRA_STAGING_EVENTS
NATS_SUBJECT_PREFIX=codestra.staging.events
NATS_CREDS_FILE=
NATS_DISPATCH_MODE=disabled
NATS_ALLOW_INSECURE_TEST_CONNECTION=false
PRODUCTION_ACTIVATION_ID=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=codestra-staging
TEMPORAL_TASK_QUEUE=codestra-staging-critical
TEMPORAL_WORKER_MODE=disabled
TEMPORAL_SERVER_ROOT_CA_FILE=
TEMPORAL_CLIENT_CERT_FILE=
TEMPORAL_CLIENT_KEY_FILE=
TEMPORAL_TLS_SERVER_NAME=
TEMPORAL_ALLOW_INSECURE_TEST_CONNECTION=false
ALLOW_IN_MEMORY_STORAGE=false
MAX_REQUEST_BODY_BYTES=1048576

# Telnexa delivery callbacks. Both controls and both shared secrets are
# required before Middleware will authenticate or acknowledge the exact
# provider callback; all values remain disabled/unset by default.
SMS_DELIVERY=false
TELNEXA_EVENT_INGRESS_ENABLED=false
TELNEXA_EVENT_API_KEY=
TELNEXA_EVENT_API_KEY_FILE=
TELNEXA_EVENT_HMAC_SECRET=
TELNEXA_EVENT_HMAC_SECRET_FILE=
TELNEXA_EVENT_SIGNATURE_TTL_SECONDS=300
TELNEXA_EVENT_REQUEST_MAX_BYTES=1048576

# Odoo adapter transport. Values are provisioned by the deployer/secret store;
# credentials must never be committed to Git.
ODOO_INTEGRATION_BASE_URL=
ODOO_INBOUND_HMAC_SECRET=

WEBHOOK_MAX_CLOCK_SKEW_SECONDS=300
WEBHOOK_REPLAY_RETENTION_SECONDS=86400

# Keycloak service tokens must carry tenant_id or tenant_ids. Caller-supplied
# tenant headers/body fields are accepted only after matching those trusted claims.

# Each producer gets a distinct secret stored outside Git.
WEBHOOK_SECRET_ODOO_INTEGRATION=
WEBHOOK_SECRET_N8N_AUTOMATION=
WEBHOOK_SECRET_VICIDIAL_ADAPTER=
WEBHOOK_SECRET_TELNEXA_GATEWAY=
WEBHOOK_SECRET_KLYROW_GATEWAY=
WEBHOOK_SECRET_KYQRA_GATEWAY=
WEBHOOK_SECRET_POSTLY_ADAPTER=

# All effects remain off on this branch.
LIVE_ADVERTISING_ENABLED=false
EXTERNAL_DELIVERY_ENABLED=false
SOCIAL_PUBLISHING_ENABLED=false
EXTERNAL_MODEL_CALLS_ENABLED=false
N8N_EXTERNAL_PROVIDER_WRITES=false
OUTBOX_DISPATCH_ENABLED=false
SEND_EVENTS=false
ENABLE_EXTERNAL_DELIVERY=false
LIVE_WRITE=false
LIVE_WRITES=false
ODOO_WRITE=false
CALLBACK_DISPATCH=false
N8N_DELIVERY_ENABLED=false
VICIDIAL_WRITES_ENABLED=false
EXTERNAL_DIAL_ENABLED=false
PRODUCTION_CALLBACKS_ENABLED=false
N8N_PRODUCTION_WORKFLOWS_ENABLED=false
PRODUCTION_DIALING=DISABLED
FORM_ODOO_DELIVERY_ENABLED=false
CRAWLER_ODOO_DELIVERY_ENABLED=false
SCRAPPER_ODOO_DELIVERY_ENABLED=false
CRAWLER_EXTERNAL_CONTACT_ENABLED=false
SCRAPPER_EXTERNAL_CONTACT_ENABLED=false
SMS_DELIVERY_ENABLED=false
EMAIL_DELIVERY_ENABLED=false
LIVE_SMS_DELIVERY=false
LIVE_EMAIL_DELIVERY=false
SOCIAL_DELIVERY_ENABLED=false
CRAWLER_EXECUTION_ENABLED=false
SCRAPPER_EXECUTION_ENABLED=false
UNRESTRICTED_CRAWLING=false

# Scoped preview/approval service; does not authorize provisioning or activation.
CAMPAIGN_DESIGN_ENABLED=false
CAMPAIGN_DESIGN_ENVIRONMENTS=test,staging
CAMPAIGN_DESIGN_CLIENT_ID=odoo-campaign-design

# Odoo campaign-control separation (migration 0066). Production write routes are
# kill-switched in the registry; these flags cannot activate them.
ODOO_CAMPAIGN_SAGA_ENABLED=false
ODOO_CAMPAIGN_SAGA_ADAPTER=synthetic
ODOO_CAMPAIGN_SAGA_LEASE_SECONDS=90
ODOO_CAMPAIGN_SAGA_RETRY_LIMIT=3
ODOO_RESULT_DELIVERY_LEASE_SECONDS=60
ODOO_RESULT_DELIVERY_RETRY_LIMIT=3
# Dedicated service clients allowed to call GET /api/v1/integrations/odoo/campaigns/...
# (scope odoo.campaigns.read). Empty = nobody. Never the agent-UI client list.
ODOO_CAMPAIGN_READER_CLIENT_IDS=
# n8n service clients accepted on /api/v1/integrations/n8n/results[/{event_id}]
# (empty = the single N8N_CAMPAIGN_SERVICE_CLIENT_ID). Tokens must carry
# environment=<ENVIRONMENT>. Staging certification values are recorded in
# deploy/keycloak/campaign-control-service-clients.v1.json (middleware_settings).
N8N_CAMPAIGN_SERVICE_CLIENT_IDS=

# Dedicated VICIdial lifecycle -> Odoo projection worker.
# Source defaults are fail closed and authorize no runtime deployment.
APP_ENV=staging
RUNTIME_PROFILE_ID=codestra-middleware-staging-v1
VICIDIAL_ODOO_PROJECTION_ENABLED=false
VICIDIAL_ODOO_SYNTHETIC_ONLY=true
VICIDIAL_ODOO_ACTIVATION_ID=
VICIDIAL_ODOO_STATE_PATH=/var/lib/codestra-middleware/vicidial-odoo-projection.sqlite3
VICIDIAL_ODOO_DURABLE_CONSUMER=codestra-vicidial-odoo-staging-v1
VICIDIAL_ODOO_BATCH_SIZE=10
VICIDIAL_ODOO_FETCH_TIMEOUT_SECONDS=2

# An enabled worker must read back exact protected-main merge SHAs. Odoo PR #78
# and VICIdial PR #17 are still candidates, so the committed source authority
# intentionally blocks startup until a separately reviewed post-merge lock update.
KEYCLOAK_LIFECYCLE_SOURCE_SHA=922d039b5143f3ac738e88998036355562a8dd5d
ODOO_CALL_EVENT_SOURCE_SHA=9f38f87138f2914622b8ac1243c7969691ac5317
VICIDIAL_EVENT_SOURCE_SHA=8007f9550a933c1cb17f21da6028dcfc41b47b0a

# These values, including both credential filename prefixes, must match
# config/vicidial-odoo-projection-runtime-authority.v1.json exactly.
NATS_URL=tls://nats.middleware-staging.svc.cluster.local:4222
NATS_STREAM=CODESTRA_STAGING_EVENTS
NATS_SUBJECT_PREFIX=codestra.staging.events
NATS_CREDS_FILE=/run/secrets/middleware-staging-vicidial-odoo-nats.creds

ODOO_19_BASE_URL=https://odoo-staging.internal.codestra
VICIDIAL_ODOO_HMAC_SECRET_FILE=/run/secrets/middleware-staging-vicidial-odoo-hmac
VICIDIAL_ODOO_TENANT_HMAC_SECRETS_FILE=

# These controls remain disabled. The projection worker never carries audio and
# never receives call-originating, callback, provider, or dialing authority.
PRODUCTION_DIALING=DISABLED
VICIDIAL_WRITES_ENABLED=false
EXTERNAL_DIAL_ENABLED=false
PRODUCTION_CALLBACKS_ENABLED=false
LIVE_SMS_DELIVERY=false
LIVE_EMAIL_DELIVERY=false
EXTERNAL_DELIVERY_ENABLED=false
ODOO_WRITE=false

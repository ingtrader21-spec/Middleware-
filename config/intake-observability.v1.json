{
  "schemaVersion": "1.0",
  "status": "SOURCE_WIRED_TARGETS_PENDING",
  "authority": "ingtrader21-spec/Middleware-",
  "metricsEndpoint": {
    "method": "GET",
    "path": "/metrics",
    "clientId": "monitoring-readonly",
    "requiredScope": "metrics.read",
    "anonymousAccess": false,
    "publicExposure": false
  },
  "intakeRoutes": [
    "/v1/intake/leads",
    "/v1/intake/surveys/responses"
  ],
  "rawMetrics": [
    "lead_submissions_total",
    "lead_duplicates_total",
    "lead_validation_failures_total",
    "lead_processing_duration_seconds",
    "lead_odoo_delivery_total",
    "lead_odoo_delivery_failures_total",
    "survey_responses_total",
    "survey_validation_failures_total",
    "survey_processing_duration_seconds",
    "intake_inbox_backlog",
    "intake_outbox_backlog",
    "intake_oldest_pending_seconds",
    "intake_backlog_collection_success",
    "intake_rate_limit_rejections_total",
    "intake_spam_rejections_total"
  ],
  "requiredCorporateLabels": [
    "codestra_business",
    "application",
    "service",
    "environment"
  ],
  "boundedOperationalLabels": {
    "codestra_business": ["platform"],
    "application": ["integration"],
    "service": ["middleware-api"],
    "channel": ["form", "landing_page", "chat", "voice", "api", "other", "unknown"],
    "form_kind": ["configured", "generic", "unknown"],
    "survey_kind": ["csat", "nps", "post_call", "post_service", "qualification", "nonprofit_impact", "other", "unknown"],
    "anonymous": ["true", "false", "unknown"],
    "result": ["accepted", "duplicate", "conflict", "success", "failure"],
    "reason": ["invalid_contract", "payload_too_large", "timeout", "authentication", "authorization", "validation", "dependency", "reconciliation", "captcha", "velocity", "reputation", "content", "policy", "unknown"],
    "delivery_target": ["nats-jetstream", "odoo-19", "analytics", "other"],
    "queue": ["inbox", "outbox:nats-jetstream", "outbox:odoo-19", "outbox:analytics", "outbox:other", "other"]
  },
  "forbiddenMetricLabelsOrValues": [
    "tenant_id",
    "tenantId",
    "customer_id",
    "customerId",
    "contact_id",
    "contactId",
    "lead_id",
    "leadId",
    "response_id",
    "responseId",
    "user_id",
    "userId",
    "email",
    "phone",
    "name",
    "address",
    "form_id",
    "formId",
    "survey_id",
    "surveyId",
    "campaign_id",
    "campaignId",
    "request_id",
    "requestId",
    "correlation_id",
    "correlationId",
    "trace_id",
    "traceId",
    "idempotency_key",
    "idempotencyKey",
    "message",
    "transcript",
    "consent_text",
    "consentText",
    "answers",
    "custom_fields",
    "customFields",
    "utm_source",
    "utmSource",
    "utm_campaign",
    "utmCampaign",
    "raw_url",
    "rawUrl",
    "query_string",
    "queryString"
  ],
  "backlogCollection": {
    "source": "middleware_inbox_and_middleware_outbox",
    "aggregateOnly": true,
    "tenantDimensionAllowed": false,
    "customerDimensionAllowed": false,
    "failureBehavior": "fail_metrics_scrape_and_set_collection_success_zero"
  },
  "workerInstrumentation": {
    "odooDeliveryHookPrepared": true,
    "falseSuccessAllowed": false,
    "odooWorkerWired": false,
    "spamControlHookPrepared": true,
    "spamControlWired": false
  },
  "releaseGates": {
    "exactHeadCiPassed": false,
    "prometheusTargetActivation": false,
    "blackboxTargetActivation": false,
    "stagingEndpointAuthenticationVerified": false,
    "stagingNoPiiScrapeVerified": false,
    "stagingRecordingRulesVerified": false,
    "stagingAlertsVerified": false,
    "stagingBacklogQueryVerified": false,
    "stagingLoadAndCardinalityVerified": false,
    "stagingEvidencePassed": false,
    "productionDeploymentApproved": false
  },
  "runtimeEffects": {
    "deploymentPerformed": false,
    "prometheusScrapeEnabled": false,
    "blackboxProbeEnabled": false,
    "odooWriteEnabled": false,
    "n8nDeliveryEnabled": false,
    "smsDeliveryEnabled": false,
    "emailDeliveryEnabled": false,
    "voiceOrPstnEnabled": false
  }
}

FROM node:22-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM dependencies AS validation
COPY . .
RUN npm run lint
RUN npm test
ARG SOURCE_COMMIT=unknown
RUN npm run build -- --mode staging

FROM nginxinc/nginx-unprivileged:1.29.4-alpine3.23 AS runtime
ARG SOURCE_COMMIT=unknown
USER 0
RUN apk upgrade --no-cache
USER 101
LABEL org.opencontainers.image.revision=$SOURCE_COMMIT \
      org.opencontainers.image.title="Codestra Agent Desktop SIP.js staging" \
      codestra.environment="STAGING" \
      codestra.external-dialing="disabled"
COPY --from=validation /app/dist /usr/share/nginx/html
COPY deploy/nginx.preview.conf /etc/nginx/conf.d/default.conf
USER 101
EXPOSE 8080

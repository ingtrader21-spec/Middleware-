# Prepared configuration only. All control and write flags remain disabled.
VICIDIAL_AUTHORIZATION_URL=https://authorization.internal.codestra.agency:8443
VICIDIAL_EDGE_URL=https://edge.internal.codestra.agency:8443
VICIDIAL_CA_FILE=/run/secrets/vicidial-mtls/ca.crt
VICIDIAL_CLIENT_CERT_FILE=/run/secrets/vicidial-mtls/client.crt

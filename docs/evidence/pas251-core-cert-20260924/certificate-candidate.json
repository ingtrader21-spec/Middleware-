  "design_review": [
    {
      "id": "DR-EDGE-01",
      "topic": "Caddy -> Kong -> Middleware:8095 path",
      "result": "SOURCE_CONSISTENT_LIVE_UNPROVEN",
      "finding": "Four repositories pin the same public route contract hash, 9c32daecd4a15104c6f9ff60ce19c8f7e78707fb31d9fd9fcb55b1b8dfa3512b: Middleware deploy/public-api-route-contract.sha256, Kong config/kong-canonical-middleware-routes.json and config/middleware-public-api-route-contract.sha256, Caddy config/caddy-kong-contract.v1.json, and Keycloak config/contracts/middleware-api-access.v3.json. The contract lists 117 operations: 105 shared_edge to middleware-integration-api:8095, 10 denied and 2 private_only to odoo:8069. Kong main carries exactly 105 openid-connect routes to middleware-integration-api:8095 and 10 request-termination denials. Caddy has no direct route to 8095. The open issues are the Caddy transitional bypass (PAS251-B031) and the production Kong drift (PAS251-B022).",
      "blockers": ["PAS251-B012", "PAS251-B022", "PAS251-B031"]
    },
    {
      "id": "DR-EDGE-02",
      "topic": "Client address trust at the Middleware listener",
      "result": "OBSERVATION",
      "finding": "Dockerfile.runtime runs uvicorn with --proxy-headers --forwarded-allow-ips=127.0.0.1. Kong reaches Middleware from another container, so X-Forwarded-For from Kong is not trusted and request.client is Kong's address. This fails safe and does not block the certificate. Any per-client-IP logic in Middleware sees the gateway address, and rate limiting belongs to Kong (rate-limiting minute=120, redis, fault_tolerant=false).",
      "blockers": []
    },
    {
      "id": "DR-TOKEN-01",
      "topic": "Token and JWKS validation",
      "result": "SOURCE_CONSISTENT_LIVE_UNPROVEN",
      "finding": "Middleware pins the staging and production issuers (https://auth-staging.codestra.co/realms/codestra, https://auth.codestra.co/realms/codestra). It requires KEYCLOAK_JWKS_URL to equal <issuer>/protocol/openid-connect/certs in deployed environments, aud=middleware-api, RS256 only, an azp allowlist and a lifetime of 300 s or less, and it refuses the synthetic CI identity outside development/test. Kong validates the same issuer through OIDC discovery with audience middleware-api and per-route scopes. The Kong route config sets no algorithm list or leeway; its authentication profile records RS256 and 0 s clock skew. The Keycloak realm sets accessTokenLifespan 300 but no defaultSignatureAlgorithm, and records no key-rotation policy.",
      "blockers": ["PAS251-B012", "PAS251-B052"]
    },
    {
      "id": "DR-SECRETS-01",
      "topic": "OpenBao references",
      "result": "UPSTREAM_AUTHORITY_ABSENT",
      "finding": "Middleware stores only openbao:// / codestra/<env>/… references and never values (app/secret_reference.py), against a vendored schema whose canonical pin verifies. The owning contract is absent from OpenBao protected main. Kong uses the env vault. Keycloak client secrets are declared external-secret-store-only, with no binding on OpenBao main.",
      "blockers": ["PAS251-B006", "PAS251-B023", "PAS251-B061"]
    },
    {
      "id": "DR-ODOO-01",
      "topic": "Odoo ACL and readback",
      "result": "SOURCE_PARTIAL_LIVE_UNPROVEN",
      "finding": "The Middleware bridge group has scoped CRUD without unlink on res.partner and mail.activity. Its ACL file grants nothing on project.task. The PAS-46 deterministic task readback is unmerged on both sides, and the only staging evidence is stale and records the readback as BLOCKED.",
      "blockers": ["PAS251-B041"]
    },
    {
      "id": "DR-GOV-01",
      "topic": "CI, review and namespace convergence",
      "result": "FAIL",

{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.codestra.agency/lead-automation/lead-event-v1.json","title":"Lead Automation Event V1","type":"object","additionalProperties":false,"required":["contract_version","event_id","event_type","occurred_at","environment","business_unit_key","campaign_key","automation_action","idempotency_key","correlation_id","policy_version","attributes_schema_key","attributes","consent_snapshot"],"properties":{"contract_version":{"const":"1.0"},"event_id":{"type":"string","pattern":"^EVT-[A-Za-z0-9_-]{8,64}$","maxLength":68},"event_type":{"enum":["lead.creation.requested.v1","lead.update.requested.v1","lead.assignment.requested.v1","lead.status_change.requested.v1","lead.callback_requested.v1"]},"occurred_at":{"type":"string","format":"date-time","maxLength":35},"environment":{"enum":["test","staging","production"]},"business_unit_key":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{1,62}$","maxLength":63},"campaign_key":{"type":"string","pattern":"^[A-Z0-9][A-Z0-9_-]{1,63}$","maxLength":64},"automation_action":{"enum":["CREATE_LEAD","UPDATE_ALLOWLISTED_FIELDS","ASSIGN_AUTHORIZED_TEAM","ASSIGN_AUTHORIZED_USER","CHANGE_AUTHORIZED_STAGE","CREATE_INTERNAL_CALLBACK_ACTIVITY"]},"idempotency_key":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"},"correlation_id":{"type":"string","format":"uuid"},"policy_version":{"type":"string","pattern":"^[A-Za-z0-9._-]{1,32}$"},"lead_uid":{"type":"string","pattern":"^LEAD-[A-Za-z0-9_-]{8,64}$","maxLength":69},"source_reference":{"type":"string","pattern":"^SRC-[A-Za-z0-9_-]{8,64}$","maxLength":68},"attributes_schema_key":{"enum":["transportation-logistics-lead-v1","web-mobile-ai-lead-v1","senior-citizen-products-lead-v1","business-loan-lead-v1","real-estate-lead-v1","fundraising-lead-v1","trading-ai-lead-v1","farming-lead-v1"]},"attributes":{"oneOf":[{"$ref":"transportation-logistics-lead-v1.json"},{"$ref":"web-mobile-ai-lead-v1.json"},{"$ref":"senior-citizen-products-lead-v1.jso
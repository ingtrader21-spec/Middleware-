{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.codestra.agency/lead-automation/lead-odoo-ack-v1.json","title":"Lead Odoo Acknowledgement V1","type":"object","additionalProperties":false,"required":["contract_version","automation_event_id","automation_action","lead_uid","odoo_record_id","result","applied_fields","unchanged_fields","rejected_fields","business_unit_key","campaign_key","policy_version","updated_at","idempotent_replay"],"properties":{"contract_version":{"const":"1.0"},"automation_event_id":{"type":"string","pattern":"^LAE-[A-Za-z0-9_-]{8,64}$","maxLength":68},"automation_action":{"enum":["CREATE_LEAD","UPDATE_ALLOWLISTED_FIELDS","ASSIGN_AUTHORIZED_TEAM","ASSIGN_AUTHORIZED_USER","CHANGE_AUTHORIZED_STAGE","CREATE_INTERNAL_CALLBACK_ACTIVITY"]},"lead_uid":{"type":"string","pattern":"^LEAD-[A-Za-z0-9_-]{8,64}$","maxLength":69},"odoo_record_id":{"type":["integer","null"],"minimum":1},"result":{"enum":["APPLIED","NO_CHANGE","DENIED","CONSENT_BLOCKED","DNC_BLOCKED","QUARANTINED","FAILED"]},"result_code":{"type":"string","pattern":"^[A-Z0-9_]{1,48}$"},"applied_fields":{"type":"array","maxItems":20,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,47}$"}},"unchanged_fields":{"type":"array","maxItems":20,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,47}$"}},"rejected_fields":{"type":"array","maxItems":20,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,47}$"}},"business_unit_key":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{1,62}$","maxLength":63},"campaign_key":{"type":"string","pattern":"^[A-Z0-9][A-Z0-9_-]{1,63}$","maxLength":64},"policy_version":{"type":"string","pattern":"^[A-Za-z0-9._-]{1,32}$"},"updated_at":{"type":"string","format":"date-time","maxLength":35},"idempotent_replay":{"type":"boolean"}},"allOf":[{"if":{"properties":{"result":{"const":"FAILED"}},"required":["result"]},"then":{"required":["result_code"]}}]}

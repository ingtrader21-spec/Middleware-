{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Lead Automation Policy V1","type":"object","additionalProperties":false,"required":["contract_version","environment","business_unit_key","campaign_key","event_type","automation_action","policy_version","decision","requires_consent","contact_eligible","allowed_fields","effective_from","approved_by","approval_reference","created_at"],"properties":{"contract_version":{"const":"1.0"},"environment":{"enum":["test","staging","production"]},"business_unit_key":{"type":"string","maxLength":63},"campaign_key":{"type":"string","maxLength":64},"event_type":{"type":"string","maxLength":48},"automation_action":{"type":"string","maxLength":48},"policy_version":{"type":"string","maxLength":32},"decision":{"enum":["ALLOW","DENY"]},"requires_consent":{"type":"boolean"},"contact_eligible":{"type":"boolean"},"allowed_fields":{"type":"array","maxItems":20,"uniqueItems":true,"items":{"type":"string","maxLength":48}},"effective_from":{"type":"string","format":"date-time"},"effective_until":{"type":["string","null"],"format":"date-time"},"approved_by":{"type":"string","pattern":"^USR-[A-Za-z0-9_-]{4,64}$"},"approval_reference":{"type":"string","pattern":"^APR-[A-Za-z0-9_-]{4,64}$"},"created_at":{"type":"string","format":"date-time"},"superseded_at":{"type":["string","null"],"format":"date-time"},"maximum_concurrency":{"type":"integer","minimum":1,"maximum":100},"rate_limit_per_minute":{"type":"integer","minimum":1,"maximum":1000}}}

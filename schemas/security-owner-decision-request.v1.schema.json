{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codestra.internal/schemas/security-owner-decision-request.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "decision_version", "decision_status", "company", "repository",
    "pr_number", "pr_head_sha", "image_repository", "image_digest",
    "candidate_manifest_sha256", "matrix_sha256", "sbom_sha256", "trivy_sha256",
    "grype_sha256", "provenance_sha256", "build_run_id", "build_run_attempt",
    "approved_scope", "authority_reference", "authority_document_sha256",
    "authority_run_id", "authority_artifact",
    "oidc_issuer", "signer_identity", "issued_utc", "expires_utc",
    "production_deployment_gate", "production_activation_gate", "canary_activation_gate",
    "server_b_access_gate", "customer_data_gate", "n8n_activation_gate",
    "external_delivery_gate", "live_calling_gate", "email_delivery_gate",
    "sms_delivery_gate", "social_posting_gate", "accepted_vulnerabilities"
  ],
  "properties": {
    "$schema": {"const": "https://codestra.internal/schemas/security-owner-decision-request.v1.json"},
    "decision_version": {"const": 1},
    "decision_status": {"const": "pending_security_owner_environment_approval"},
    "company": {"const": "Codestra LLC"},
    "repository": {"const": "ingtrader21-spec/Middleware-"},
    "pr_number": {"type": "integer", "minimum": 1},
    "pr_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "image_repository": {"enum": [
      "ghcr.io/appolon1908-hue/codestra-middleware",
      "ghcr.io/codestra-srl/codestra-agent-desktop",
      "ghcr.io/codestra-srl/codestra-websocket-gateway"
    ]},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sbom_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trivy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "grype_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "build_run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "build_run_attempt": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "approved_scope": {"const": "server_a_isolated_staging"},
    "authority_reference": {"type": "string", "minLength": 1},
    "authority_document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "authority_artifact": {"type": "string", "pattern": "^security-owner-authority-[1-9][0-9]*-[1-9][0-9]*$"},
    "oidc_issuer": {"const": "https://token.actions.githubusercontent.com"},
    "signer_identity": {"enum": [
      "https://github.com/ingtrader21-spec/Middleware-/.github/workflows/staging-candidate-build-sign.yml@refs/heads/main",
      "https://github.com/ingtrader21-spec/Middleware-/.github/workflows/release-component-candidate.yml@refs/heads/main"
    ]},
    "issued_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "expires_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "production_deployment_gate": {"const": "blocked"},
    "production_activation_gate": {"const": "blocked"},
    "canary_activation_gate": {"const": "blocked"},
    "server_b_access_gate": {"const": "blocked"},
    "customer_data_gate": {"const": "blocked"},
    "n8n_activation_gate": {"const": "blocked"},
    "external_delivery_gate": {"const": "blocked"},
    "live_calling_gate": {"const": "blocked"},
    "email_delivery_gate": {"const": "blocked"},
    "sms_delivery_gate": {"const": "blocked"},
    "social_posting_gate": {"const": "blocked"},
    "accepted_vulnerabilities": {"type": "array", "items": {"type": "object"}}
  }
}

            ]
          }
        }
      ]
    },
    {
      "name": "03 Accept TEST_SYN command",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bearer_token}}",
            "type": "text"
          },
          {
            "key": "X-Tenant-ID",
            "value": "{{tenant_id}}",
            "type": "text"
          },
          {
            "key": "X-Request-Id",
            "value": "{{request_id}}",
            "type": "text"
          },
          {
            "key": "X-Correlation-ID",
            "value": "{{correlation_id}}",
            "type": "text"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/platform/v1/commands",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "platform",
            "v1",
            "commands"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"command_id\": \"{{command_id}}\",\n  \"command_type\": \"test.syn.execute.v1\",\n  \"command_version\": \"1.0\",\n  \"target\": \"test-syn\",\n  \"tenant_id\": \"{{tenant_id}}\",\n  \"requested_by\": \"user-1\",\n  \"correlation_id\": \"{{correlation_id}}\",\n  \"idempotency_key\": \"{{idempotency_key}}\",\n  \"capability\": \"TEST_SYN_EXECUTE\",\n  \"payload\": {\n    \"probe\": true,\n    \"certification\": \"section4-postman-local\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('accepted 202',()=>pm.response.to.have.status(202));",
              "const b=pm.response.json(); pm.test('command id stable',()=>pm.expect(b.command_id).to.eql(pm.environment.get('command_id')));",
              "pm.test('request id returned',()=>pm.expect(pm.response.headers.get('X-Request-Id')).to.be.ok);",
              "pm.test('correlation returned',()=>pm.expect(pm.response.headers.get('X-Correlation-Id')).to.eql(pm.environment.get('correlation_id')));"
            ]
          }
        }
      ]
    },

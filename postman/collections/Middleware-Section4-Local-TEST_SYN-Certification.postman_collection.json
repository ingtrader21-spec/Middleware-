{
  "info": {
    "_postman_id": "middleware-section4-local-certification",
    "name": "Middleware Section 4 - Local TEST_SYN Certification",
    "description": "Local-only, synthetic certification for canonical Middleware :8095. No external provider effects.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"

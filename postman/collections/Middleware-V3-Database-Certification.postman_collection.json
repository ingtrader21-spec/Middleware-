                "exec": [
                  "pm.test('schema 200',()=>pm.response.to.have.status(200));",
                  "const j=pm.response.json();",
                  "pm.test('single head',()=>pm.expect(j.head_count).to.eql(1));",
                  "pm.test('exact head',()=>pm.expect(j.alembic_head).to.eql(pm.environment.get('expected_alembic_head')));",
                  "pm.test('no drift',()=>pm.expect(j.drift_detected).to.eql(false));",
                  "pm.test('runtime verified',()=>pm.expect(j.runtime_schema_verified).to.eql(true));"
                ]

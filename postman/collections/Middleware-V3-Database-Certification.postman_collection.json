{
  "info": {
    "name": "Middleware V3 Database Certification Control",
    "description": "PostgreSQL/private DB operational certification overlay for ingtrader21-spec/Middleware-. No raw SQL. Production-safe is read-only. Linear PAS-98; DB Program PAS-77.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const env = String(pm.variables.replaceIn('{{environment}}') || 'local').trim().toLowerCase();",
          "const allow = String(pm.variables.replaceIn('{{allow_database_mutations}}') || 'false').trim().toLowerCase() === 'true';",
          "const mutating = ['POST','PUT','PATCH','DELETE'].includes(String(pm.request.method || '').toUpperCase());",
          "const privateTarget = pm.request.headers.get('X-Codestra-Certification-Target') === 'private';",
          "pm.request.headers.remove('X-Codestra-Certification-Target');",
          "if (privateTarget) {",
          "  const privateBase = String(pm.variables.replaceIn('{{db_private_base_url}}') || '').trim();",
          "  if (!privateBase || privateBase.includes('{{')) {",
          "    throw new Error('DB_PRIVATE_BASE_URL_REQUIRED');",
          "  }",
          "}",
          "if (['production','prod'].includes(env) && mutating) {",
          "  throw new Error('PRODUCTION_DATABASE_MUTATION_GATED');",
          "}",
          "if (!['production','prod'].includes(env) && mutating && !allow) {",
          "  throw new Error('DATABASE_MUTATION_OPT_IN_REQUIRED');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 Health & Readiness",
      "item": [
        {
          "name": "DB Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Codestra-Certification-Target",
                "value": "private",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{db_read_token}}"
              }
            ],
            "url": "{{db_private_base_url}}/internal/v1/database/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('DB health 200',()=>pm.response.to.have.status(200));",
                  "const j=pm.response.json();",
                  "pm.test('TLS active',()=>pm.expect(j.tls_active).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "DB Readiness",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Codestra-Certification-Target",
                "value": "private",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{db_read_token}}"
              }
            ],
            "url": "{{db_private_base_url}}/internal/v1/database/readiness"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('DB readiness 200',()=>pm.response.to.have.status(200));",
                  "const j=pm.response.json();",
                  "pm.test('ready true',()=>pm.expect(j.ready).to.eql(true));",
                  "pm.test('head exact',()=>pm.expect(j.alembic_head).to.eql(pm.environment.get('expected_alembic_head')));",
                  "pm.test('TLS required and active',()=>{pm.expect(j.tls_required).to.eql(true);pm.expect(j.tls_active).to.eql(true);});"
                ]
              }
            }
          ]
        }
      ]
    },

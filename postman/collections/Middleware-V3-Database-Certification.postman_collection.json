                "key": "Authorization",
                "value": "Bearer {{db_verify_token}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{db_private_base_url}}/internal/v1/database/migrations/verify"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('verify 200',()=>pm.response.to.have.status(200));",
                  "const j=pm.response.json();",
                  "pm.test('verified true',()=>pm.expect(j.verified).to.eql(true));",
                  "pm.test('read only',()=>pm.expect(j.read_only).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Migration Apply Must Not Exist",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Codestra-Certification-Target",
                "value": "private",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{db_read_token}}"
              }
            ],
            "url": "{{db_private_base_url}}/internal/v1/database/migrations/apply"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('no HTTP migration apply',()=>pm.expect([404,405]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },

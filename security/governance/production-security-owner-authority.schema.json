{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codestra.internal/schemas/production-security-owner-authority.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "company", "authority_id", "role", "authorized_identity",
    "github_identity", "authority_reference", "approved_scopes", "prohibited_scopes",
    "source_sha", "communications", "issued_utc", "not_before_utc", "expires_utc",
    "approving_authority", "signature_method", "signature_key_id",
    "detached_signature_path", "document_sha256"
  ],
  "properties": {
    "schema_version": {"const": "codestra.security-owner.production-authority.v1"},
    "company": {"const": "Codestra LLC"},
    "authority_id": {"type": "string", "minLength": 1},
    "role": {"const": "Security Owner"},
    "authorized_identity": {"type": "string", "pattern": "^https://github.com/[A-Za-z0-9-]+$"},
    "github_identity": {"type": "string", "pattern": "^[A-Za-z0-9-]+$"},
    "authority_reference": {"type": "string", "minLength": 1},
    "approved_scopes": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["server_a_production_release", "production_deployment", "external_delivery_synthetic_only"]},
      "minItems": 3, "maxItems": 3
    },
    "prohibited_scopes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "communications": {
      "type": "object", "additionalProperties": false,
      "required": ["calls", "sms", "email", "callbacks"],
      "properties": {
        "calls": {"const": false}, "sms": {"const": false},
        "email": {"const": false}, "callbacks": {"const": false}
      }
    },
    "issued_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "not_before_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "expires_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "approving_authority": {"type": "string", "minLength": 1},
    "signature_method": {"const": "sigstore-keyless-oidc"},
    "signature_key_id": {"const": "https://token.actions.githubusercontent.com"},
    "detached_signature_path": {"const": "security-owner-authority.sigstore.json"},
    "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

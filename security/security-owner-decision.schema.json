{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codestra.example/security/security-owner-decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_status", "decision_request_sha256", "repository",
    "pr_number", "pr_head_sha", "middleware_main_sha", "odoo_main_sha",
    "approved_scope", "approved_image_digests", "accepted_vulnerability_findings",
    "compensating_controls_sha256", "odoo_isolation_evidence_sha256",
    "middleware_isolation_evidence_sha256", "security_owner_approver_login",
    "security_owner_authority_reference", "environment_name",
    "environment_approval_record_id", "workflow_repository", "workflow_path",
    "workflow_ref", "workflow_sha", "workflow_run_id", "workflow_run_attempt",
    "signed_at_utc", "expires_at_utc", "negative_authorizations",
    "revocation_conditions", "image_manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "decision_status": {"const": "approved_for_staging_preparation"},
    "decision_request_sha256": {"$ref": "#/$defs/sha256"},
    "repository": {"const": "Codestra-SRL/codestra-middleware"},
    "pr_number": {"type": "integer", "minimum": 1},
    "pr_head_sha": {"$ref": "#/$defs/gitSha"},
    "middleware_main_sha": {"$ref": "#/$defs/gitSha"},
    "odoo_main_sha": {"$ref": "#/$defs/gitSha"},
    "approved_scope": {"const": "server_a_isolated_staging"},
    "approved_image_digests": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/digest"}},
    "accepted_vulnerability_findings": {"type": "array", "items": {"type": "object"}},
    "compensating_controls_sha256": {"$ref": "#/$defs/sha256"},
    "odoo_isolation_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "middleware_isolation_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "security_owner_approver_login": {"const": "kazan555"},
    "security_owner_authority_reference": {"const": "SECURITY.md#isolated-staging-security-owner"},
    "environment_name": {"const": "security-owner-signing"},
    "environment_approval_record_id": {"type": "string", "minLength": 1},
    "workflow_repository": {"const": "Codestra-SRL/codestra-middleware"},
    "workflow_path": {"const": ".github/workflows/security-owner-decision-sign.yml"},
    "workflow_ref": {"const": "refs/heads/main"},
    "workflow_sha": {"$ref": "#/$defs/gitSha"},
    "workflow_run_id": {"type": "string", "pattern": "^[0-9]+$"},
    "workflow_run_attempt": {"type": "string", "pattern": "^[0-9]+$"},
    "signed_at_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "negative_authorizations": {"type": "object"},
    "revocation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "image_manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}

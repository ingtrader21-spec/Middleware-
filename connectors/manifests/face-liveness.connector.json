{
  "$schema": "https://contracts.codestra.co/connectors/connector-manifest.v1.schema.json",
  "manifest_version": "1.0",
  "connector_id": "face-liveness",
  "display_name": "Codestra-Face-Liveness",
  "version": "1.0.0",
  "cell": "core-communications",
  "repository": "ingtrader21-spec/Codestra-Face-Liveness",
  "enabled_by_default": false,
  "direct_n8n_access": false,
  "runtime_binding": {
    "status": "UNVERIFIED_TEMPLATE_ONLY",
    "base_url": "https://face-liveness.internal.invalid",
    "health_path": "/health/ready",
    "operation_path_template": "/internal/v1/commands/{operation_id}"
  },
  "authentication": {
    "type": "oauth2-plus-mtls",
    "audience": "face-liveness",
    "scopes": [
      "connector.face-liveness.command",
      "connector.face-liveness.read"
    ],
    "secret_references": [
      "CONNECTOR_FACE_LIVENESS_CLIENT_SECRET",
      "CONNECTOR_FACE_LIVENESS_MTLS_CERT"
    ]
  },
  "commands": [
    {
      "prefix": "face-liveness.",
      "required_capability": "FACE_LIVENESS_VERIFY",
      "timeout_seconds": 30,
      "readback_required": true,
      "retry_policy": {
        "maximum_attempts": 5,
        "initial_backoff_seconds": 2,
        "maximum_backoff_seconds": 120,
        "jitter_ratio": 0.2,
        "unknown_outcome_requires_readback": true
      }
    }
  ],
  "events": [],
  "webhooks": [],
  "forbidden_command_prefixes": [],
  "forbidden_payload_keys": [
    "access_token",
    "client_secret",
    "password",
    "private_key",
    "provider_token",
    "refresh_token",
    "sql",
    "dsn",
    "image",
    "embedding",
    "stream_url"
  ],
  "workflow_families": [
    "face-liveness.verify"
  ],
  "metadata": {
    "source_only": true,
    "runtime_activation_authorized": false,
    "owner": "face-liveness",
    "internal_api_contract": "contracts/platform/identity-services-adapter.v1.openapi.json",
    "source_revision": "e664aa4fe1153d59dd7a468b768e7bd0d10b92f8",
    "readiness_source_verified": true,
    "live_endpoint_verified": false,
    "service_catalog": "contracts/platform/identity-services.catalog.v1.json"
  }
}

{
  "$schema": "https://contracts.codestra.co/connectors/connector-manifest.v1.schema.json",
  "manifest_version": "1.0",
  "connector_id": "camera-gateway",
  "display_name": "Codestra-Camera-Gateway",
  "version": "1.0.0",
  "cell": "core-communications",
  "repository": "ingtrader21-spec/Codestra-Camera-Gateway",
  "enabled_by_default": false,
  "direct_n8n_access": false,
  "runtime_binding": {
    "status": "UNVERIFIED_TEMPLATE_ONLY",
    "base_url": "https://camera-gateway.internal.invalid",
    "health_path": "/health/ready",
    "operation_path_template": "/internal/v1/commands/{operation_id}"
  },
  "authentication": {
    "type": "oauth2-plus-mtls",
    "audience": "camera-gateway",
    "scopes": [
      "connector.camera-gateway.command",
      "connector.camera-gateway.read"
    ],
    "secret_references": [
      "CONNECTOR_CAMERA_GATEWAY_CLIENT_SECRET",
      "CONNECTOR_CAMERA_GATEWAY_MTLS_CERT"
    ]
  },
  "commands": [
    {
      "prefix": "camera-gateway.",
      "required_capability": "CAMERA_CAPTURE",
      "timeout_seconds": 30,
      "readback_required": true,
      "retry_policy": {
        "maximum_attempts": 5,
        "initial_backoff_seconds": 2,
        "maximum_backoff_seconds": 120,
        "jitter_ratio": 0.2,
        "unknown_outcome_requires_readback": true
      }
    }
  ],
  "events": [],
  "webhooks": [],
  "forbidden_command_prefixes": [],
  "forbidden_payload_keys": [
    "access_token",
    "client_secret",
    "password",
    "private_key",
    "provider_token",
    "refresh_token",
    "sql",
    "dsn",
    "image",
    "embedding",
    "stream_url"
  ],
  "workflow_families": [
    "camera-gateway.capture"
  ],
  "metadata": {
    "source_only": true,
    "runtime_activation_authorized": false,
    "owner": "camera-gateway",
    "internal_api_contract": "contracts/platform/identity-services-adapter.v1.openapi.json"
  }
}

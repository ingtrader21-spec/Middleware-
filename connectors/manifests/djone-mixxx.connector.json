{
  "$schema": "https://contracts.codestra.co/connectors/connector-manifest.v1.schema.json",
  "manifest_version": "1.0",
  "connector_id": "djone-mixxx",
  "display_name": "DJONE Mixxx Native Control",
  "version": "1.0.0",
  "cell": "core-communications",
  "repository": "ingtrader21-spec/DJONE",
  "enabled_by_default": false,
  "direct_n8n_access": false,
  "runtime_binding": {
    "status": "UNVERIFIED_TEMPLATE_ONLY",
    "base_url": "https://djone.internal.invalid",
    "health_path": "/health",
    "operation_path_template": "/v1/commands/{operation_id}"
  },
  "authentication": {
    "type": "oauth2-plus-mtls",
    "audience": "codestra-middleware-api",
    "scopes": [
      "connector.djone-mixxx.command",
      "connector.djone-mixxx.read"
    ],
    "secret_references": [
      "CONNECTOR_DJONE_MIXXX_CLIENT_SECRET",
      "CONNECTOR_DJONE_MIXXX_MTLS_CERT"
    ]
  },
  "commands": [
    {
      "prefix": "djone.",
      "required_capability": "DJONE_CONTROL",
      "timeout_seconds": 10,
      "readback_required": true,
      "retry_policy": {
        "maximum_attempts": 1,
        "initial_backoff_seconds": 0,
        "maximum_backoff_seconds": 0,
        "jitter_ratio": 0,
        "unknown_outcome_requires_readback": true
      }
    }
  ],
  "events": [
    {
      "event_type": "djone.safety.changed.v1",
      "direction": "inbound"
    },
    {
      "event_type": "djone.deck.readback.v1",
      "direction": "inbound"
    }
  ],
  "webhooks": [],
  "forbidden_command_prefixes": [],
  "forbidden_payload_keys": [
    "access_token",
    "client_secret",
    "password",
    "private_key",
    "provider_token",
    "refresh_token"
  ],
  "workflow_families": [
    "djone.native-control",
    "djone.safety"
  ],
  "metadata": {
    "source_only": true,
    "runtime_activation_authorized": false,
    "owner": "djone",
    "native_readback_required": true,
    "live_execution_default": false,
    "emergency_stop_required": true,
    "idempotency_required": true
  }
}

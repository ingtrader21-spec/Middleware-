{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codestra.internal/schemas/cross-server/v1/envelope.schema.json",
  "title": "Codestra Cross-Server Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation", "environment", "business_unit",
    "campaign_id", "request_id", "correlation_id", "idempotency_key",
    "test_only", "production_eligible", "issued_at", "expires_at", "payload"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "operation": {"type": "string", "minLength": 1, "maxLength": 64},
    "environment": {"enum": ["test", "staging"]},
    "business_unit": {"enum": ["TL", "DEV", "SCP"]},
    "campaign_id": {"type": "string", "pattern": "^[A-Z0-9_-]{1,32}$"},
    "request_id": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 255},
    "test_only": {"const": true},
    "production_eligible": {"const": false},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"}
  }
}

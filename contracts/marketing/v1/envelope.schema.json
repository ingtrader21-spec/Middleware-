{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codestra://contracts/marketing/v1/envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_version", "tenant_id", "occurred_at", "correlation_id", "payload"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
    "event_version": {"type": "integer", "minimum": 1},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "occurred_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "minLength": 8, "maxLength": 200},
    "causation_id": {"type": ["string", "null"], "maxLength": 200},
    "idempotency_key": {"type": ["string", "null"], "maxLength": 200},
    "actor": {"type": ["object", "null"]},
    "payload": {"type": "object"}
  }
}

{"$id":"https://contracts.codestra.co/connectors/cloudevent.v1.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":true,"description":"CloudEvents 1.0 structured JSON event with Codestra extension attributes.","properties":{"causationid":{"maxLength":180,"minLength":1,"type":"string"},"connectorid":{"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","type":"string"},"correlationid":{"maxLength":180,"minLength":1,"type":"string"},"data":{"type":"object"},"datacontenttype":{"const":"application/json","type":"string"},"dataschema":{"format":"uri","type":"string"},"endpointkey":{"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","type":"string"},"id":{"maxLength":256,"minLength":1,"type":"string"},"source":{"format":"uri-reference","minLength":1,"type":"string"},"specversion":{"const":"1.0"},"subject":{"maxLength":256,"minLength":1,"type":"string"},"tenantid":{"format":"uuid","type":"string"},"time":{"format":"date-time","type":"string"},"traceparent":{"pattern":"^(?!ff)[0-9a-f]{2}-(?!0{32})[0-9a-f]{32}-(?!0{16})[0-9a-f]{16}-[0-9a-f]{2}$","type":"string"},"tracestate":{"maxLength":512,"type":"string"},"type":{"pattern":"^[a-z0-9]+(?:[.-][a-z0-9]+)*\\.v[1-9][0-9]*$","type":"string"}},"required":["specversion","id","source","type","time","datacontenttype","data","tenantid","correlationid","causationid","connectorid","endpointkey"],"title":"Codestra CloudEvents 1.0 JSON Envelope","type":"object"}

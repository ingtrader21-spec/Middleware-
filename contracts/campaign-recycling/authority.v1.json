  "sender_identity_rule": {
    "identity_must_be": [
      "legitimate",
      "brand_or_campaign_owned",
      "channel_verified",
      "production_authorized_for_channel"
    ],
    "selection": "policy_governed",
    "binding": "campaign_version",
    "auditable": true,
    "rotation_for_deliverability_evasion": false,
    "forbidden_practices": [
      "rotating sending domains to evade spam filtering, blocklists, reputation, or provider limits",
      "rotating sender identities or address formats per touch to evade complaint or bounce controls",
      "lookalike, throwaway, or unregistered sending domains",
      "sending from an identity outside approvedSenders or approvedDomains"
    ],
    "enforcement": "A candidate whose channel-specific sender identity is not authorized is rejected with SENDER_IDENTITY_NOT_AUTHORIZED; the engine never substitutes another identity to recover deliverability.",

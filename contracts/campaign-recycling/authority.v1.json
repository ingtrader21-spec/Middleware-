    },
    {
      "id": "leads-thunderbird-registration",
      "detail": "DEFERRED, not ambiguous: Leads and Thunderbird roles are frozen in this matrix; platform registry registration belongs to Milestone 30 security/integration and cannot change ownership semantics.",

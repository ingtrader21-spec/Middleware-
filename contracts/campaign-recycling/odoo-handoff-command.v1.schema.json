{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.codestra.co/campaign-recycling/odoo-handoff-command.v1.schema.json",
  "title": "MCR to Odoo CRM lifecycle handoff command (contract only)",
  "description": "Extends the canonical Middleware command envelope. Not registered for dispatch. dry_run is pinned true until an independently reviewed runtime implementation and Odoo adapter certification exist.",
  "allOf": [
    {
      "$ref": "../platform/command-envelope.v1.schema.json"
    },
    {
      "properties": {
        "command_type": {
          "const": "crm.lifecycle.handoff"
        },
        "target": {
          "const": "odoo-19"
        },
        "capability": {
          "const": "ODOO_WRITE"
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "requested_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^mcrodoo1:[a-f0-9]{64}$"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "lead_id",
            "campaign_id",
            "campaign_version",
            "lifecycle_version",
            "policy_version",
            "handoff",
            "lifecycle_state",
            "signal",
            "evidence_source",
            "evidence_id",
            "evidence_hash",
            "occurred_at",
            "dry_run",
            "allow_external_contact"
          ],
          "properties": {
            "schema_version": {
              "const": "1.0"
            },
            "lead_id": {
              "$ref": "lifecycle.v1.schema.json#/$defs/LeadId"
            },
            "campaign_id": {
              "type": "string",
              "pattern": "^(klyrow|whatsapp):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "campaign_version": {
              "type": "integer",
              "minimum": 1
            },
            "lifecycle_version": {
              "type": "integer",
              "minimum": 1
            },
            "policy_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^\\S(?:.*\\S)?$"
            },
            "handoff": {
              "enum": [
                "accepted",
                "engaged",
                "conversion"
              ]
            },
            "lifecycle_state": {
              "enum": [
                "ELIGIBLE",
                "ACTIVE_CYCLE",
                "ENGAGED",
                "CONVERTED"
              ]
            },
            "signal": {
              "enum": [
                "policy_accepted",
                "click",
                "reply",
                "conversion"
              ]
            },
            "evidence_source": {
              "enum": [
                "middleware",
                "odoo"
              ]
            },
            "evidence_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180,
              "pattern": "^\\S(?:.*\\S)?$"
            },
            "evidence_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "occurred_at": {
              "type": "string",
              "format": "date-time"
            },
            "dry_run": {
              "const": true
            },
            "allow_external_contact": {
              "const": false
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "handoff": {
                    "const": "accepted"
                  }
                }
              },
              "then": {
                "properties": {
                  "lifecycle_state": {
                    "enum": [
                      "ELIGIBLE",
                      "ACTIVE_CYCLE"
                    ]
                  },
                  "signal": {
                    "enum": [
                      "policy_accepted"
                    ]
                  },
                  "evidence_source": {
                    "const": "middleware"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "handoff": {
                    "const": "engaged"
                  }
                }
              },
              "then": {
                "properties": {
                  "lifecycle_state": {
                    "enum": [
                      "ENGAGED"
                    ]
                  },
                  "signal": {
                    "enum": [
                      "click",
                      "reply"
                    ]
                  },
                  "evidence_source": {
                    "const": "middleware"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "handoff": {
                    "const": "conversion"
                  }
                }
              },
              "then": {
                "properties": {
                  "lifecycle_state": {
                    "enum": [
                      "CONVERTED"
                    ]
                  },
                  "signal": {
                    "enum": [
                      "conversion"
                    ]
                  },
                  "evidence_source": {
                    "const": "odoo"
                  }
                }
              }
            }
          ]
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.codestra.co/campaign-recycling/odoo-handoff-readback.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "lead_id",
    "campaign_id",
    "campaign_version",
    "lifecycle_version",
    "policy_version",
    "handoff",
    "command_id",
    "correlation_id",
    "idempotency_key",
    "payload_hash",
    "status",
    "odoo_record_id",
    "observed_lifecycle_version",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "lead_id": {
      "$ref": "lifecycle.v1.schema.json#/$defs/LeadId"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^(klyrow|whatsapp):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "campaign_version": {
      "type": "integer",
      "minimum": 1
    },
    "lifecycle_version": {
      "type": "integer",
      "minimum": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "handoff": {
      "enum": [
        "accepted",
        "engaged",
        "conversion"
      ]
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^mcrodoo1:[a-f0-9]{64}$"
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "accepted",
        "applied",
        "not_found",
        "unknown",
        "rejected"
      ]
    },
    "odoo_record_id": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "observed_lifecycle_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "applied"
          }
        }
      },
      "then": {
        "properties": {
          "odoo_record_id": {
            "type": "integer"
          },
          "observed_lifecycle_version": {
            "type": "integer"
          }
        }
      },
      "else": {
        "properties": {
          "odoo_record_id": {
            "type": "null"
          },
          "observed_lifecycle_version": {
            "type": "null"
          }
        }
      }
    }
  ]
}

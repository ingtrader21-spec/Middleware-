    {"prefix": "real-wallet.operations.", "scope": "automation.command.product", "client": "n8n-product-automation", "workflow_families": ["product.trading-nonfinancial"]},
    {"prefix": "privacy.", "scope": "automation.command.privacy", "client": "n8n-privacy-automation", "workflow_families": ["privacy"]}
